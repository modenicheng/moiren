// Moiren design tokens.
//
// Every color, spacing, radius and type size the UI uses lives here as an
// `out property` on the `Theme` global, selected by a single `dark` boolean.
// To add a new theme later, extend the ternaries (or add a `ThemePreference`
// case) — no component needs to change, because components only read
// `Theme.<token>`.

import { Palette } from "std-widgets.slint";

export enum ThemePreference { system, light, dark }

export global Theme {
    // --- Scheme selection ------------------------------------------------
    // Defaults to following the OS; a user override wins (see Settings page).
    in-out property <ThemePreference> preference: ThemePreference.dark;

    out property <bool> dark:
        preference == ThemePreference.dark ? true
        : preference == ThemePreference.light ? false
        : Palette.color-scheme == ColorScheme.dark;

    // --- Brand -----------------------------------------------------------
    // Primary is a professional violet. All brand variations derive from it,
    // so a rebrand only touches these three lines.
    out property <color> primary:          dark ? #8b5cf6 : #7c3aed;
    out property <color> primary-hover:    dark ? #9d74f8 : #8b5cf6;
    out property <color> primary-pressed:  dark ? #7c4ddb : #6d28d9;
    out property <color> primary-soft:     dark ? #8b5cf6.with-alpha(0.16) : #7c3aed.with-alpha(0.12);
    out property <color> on-primary:       #ffffff;

    out property <brush> brand-gradient: @linear-gradient(135deg,
        (dark ? #a855f7 : #8b5cf6) 0%,
        (dark ? #6d28d9 : #7c3aed) 55%,
        (dark ? #4f46e5 : #6366f1) 100%);

    // --- Surfaces --------------------------------------------------------
    out property <color> window-bg:   dark ? #141019 : #f5f3fb;
    out property <color> surface:     dark ? #1c1826 : #ffffff;
    out property <color> surface-2:   dark ? #231d31 : #faf9fe;
    out property <color> surface-3:   dark ? #2a2340 : #f0edf8;
    out property <color> titlebar:    dark ? #18131f : #efecf6;
    out property <color> sidebar:     dark ? #171320 : #ffffff;

    // --- Lines & focus ---------------------------------------------------
    out property <color> border:       dark ? #322b45 : #e6e1f1;
    out property <color> border-strong: dark ? #433a5c : #d4ccea;
    out property <color> focus-ring:    primary.with-alpha(0.55);
    out property <color> overlay-scrim: #000000.with-alpha(dark ? 0.55 : 0.35);

    // --- Text ------------------------------------------------------------
    out property <color> text:        dark ? #ecebf4 : #1b1626;
    out property <color> text-muted:  dark ? #a39fb6 : #5f596f;
    out property <color> text-faint:  dark ? #6f6986 : #938da6;
    out property <color> text-on-soft: primary;

    // --- Semantic status -------------------------------------------------
    out property <color> success:   dark ? #34d399 : #10b981;
    out property <color> warning:   dark ? #fbbf24 : #d97706;
    out property <color> danger:    dark ? #f87171 : #dc2626;
    out property <color> info:      dark ? #60a5fa : #2563eb;
    out property <color> success-soft: success.with-alpha(0.16);
    out property <color> warning-soft: warning.with-alpha(0.16);
    out property <color> danger-soft:  danger.with-alpha(0.16);

    // Audio level meter stops.
    out property <color> meter-low:  success;
    out property <color> meter-mid:  warning;
    out property <color> meter-high: danger;

    // --- Spacing scale (4pt based) --------------------------------------
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 24px;
    out property <length> space-6: 32px;
    out property <length> space-7: 48px;

    // --- Radii -----------------------------------------------------------
    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;
    out property <length> radius-lg: 16px;
    out property <length> radius-xl: 22px;
    out property <length> radius-pill: 999px;

    // --- Typography ------------------------------------------------------
    out property <length> text-xs:  11px;
    out property <length> text-sm:  13px;
    out property <length> text-md:  15px;
    out property <length> text-lg:  18px;
    out property <length> text-xl:  22px;
    out property <length> text-2xl: 30px;

    out property <int> weight-regular:  400;
    out property <int> weight-medium:   500;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold:     700;

    // --- Motion ----------------------------------------------------------
    out property <duration> fast: 120ms;
    out property <duration> normal: 200ms;
    out property <duration> slow: 320ms;

    // --- Elevation (soft shadow for cards/popovers) ----------------------
    out property <color> shadow: #000000.with-alpha(dark ? 0.45 : 0.12);
    out property <length> shadow-blur: 24px;
    out property <length> shadow-blur-sm: 12px;
}
