// Moiren — application shell.
//
// A frameless window built from our own parts: title bar (brand, page context,
// engine state, window controls), navigation rail, routed content area and a
// status bar. The shell is also the single place that publishes the window
// geometry to `Theme.viewport-*`, which is what lets every page pick the
// windowed (1180x760) or full-screen (1600x956) layout without knowing that
// `MainWindow` exists.
//
// The `Backend` global is re-exported here (and in tray.slint) so the Rust side
// can address `ui::Backend`; each window owns its own instance of the global.

export { AppTray } from "tray.slint";
export { Backend, BackendPhase, AudioEndpoint, ProcessSource } from "backend.slint";
import { Backend, BackendPhase } from "backend.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Badge, IconButton, NavItem, SectionLabel } from "components.slint";
import { MonitorPage } from "pages/monitor.slint";
import { RenderPage } from "pages/render.slint";
import { DevicesPage } from "pages/devices.slint";
import { SettingsPage } from "pages/settings.slint";

// A rail group heading ("工作区" / "系统").
component RailLabel inherits HorizontalLayout {
    in property <string> text;
    padding-left: Theme.space-2;
    padding-right: Theme.space-2;
    padding-top: Theme.space-3;
    padding-bottom: Theme.space-2;
    SectionLabel { text: root.text; }
}

export component MainWindow inherits Window {
    title: "Moiren";
    no-frame: true;
    background: transparent;
    min-width: 940px;
    min-height: 620px;
    preferred-width: 1180px;
    preferred-height: 760px;

    // Publish geometry to the theme, so pages can branch on `Theme.compact`
    // and every chrome token can pick its size-class value. A global's property
    // cannot take a binding from a component's own geometry, so this mirrors
    // the window size into component properties and pushes them on change.
    in-out property <length> shell-width: self.width;
    in-out property <length> shell-height: self.height;
    changed shell-width => { Theme.viewport-width = self.shell-width; }
    changed shell-height => { Theme.viewport-height = self.shell-height; }
    init => {
        Theme.viewport-width = self.width;
        Theme.viewport-height = self.height;
    }

    // Window control callbacks for the backend to wire; UI-only here.
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback exit-app();

    in-out property <int> page: 0;

    out property <string> page-title: page == 0 ? "监控路由"
        : page == 1 ? "测试音"
        : page == 2 ? "音频设备"
        : "设置";

    property <bool> running: Backend.active;
    property <bool> failed: Backend.phase == BackendPhase.failed;
    // One line for whatever the service most recently wanted to say.
    property <string> diagnostics:
        Backend.error-text != "" ? Backend.error-text
        : Backend.catalog-error != "" ? "目录刷新失败：" + Backend.catalog-error
        : "";
    property <bool> has-diagnostics: root.diagnostics != "";

    // Outer frame: rounded and outlined as a window, edge-to-edge once we are at
    // the full-screen size class.
    Rectangle {
        background: Theme.window-bg;
        border-radius: Theme.compact ? Theme.radius-lg : 0px;
        border-width: Theme.compact ? 1px : 0px;
        border-color: Theme.border-strong;
        clip: true;

        VerticalLayout {
            // ---------------- Title bar ----------------
            Rectangle {
                height: Theme.titlebar-height;
                background: Theme.titlebar;
                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: Theme.hairline;
                }
                HorizontalLayout {
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-3;

                    // Brand mark and wordmark come from the supplied Figma
                    // export; each scheme uses its own variant, so neither is
                    // colorized here.
                    Image {
                        source: Theme.dark
                            ? @image-url("../../../assets/logos/moiren-2c-mark-dark.svg")
                            : @image-url("../../../assets/logos/moiren-2c-mark-light.svg");
                        width: 22px;
                        height: 22px;
                        image-fit: contain;
                        y: (parent.height - self.height) / 2;
                    }
                    Image {
                        source: Theme.dark
                            ? @image-url("../../../assets/logos/moiren-2c-wordmark-dark.svg")
                            : @image-url("../../../assets/logos/moiren-2c-wordmark-light.svg");
                        width: 86px;
                        height: 22px;
                        image-fit: contain;
                        y: (parent.height - self.height) / 2;
                    }
                    Rectangle {
                        width: 1px;
                        height: 18px;
                        background: Theme.border;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "Moiren · " + root.page-title;
                        color: Theme.text-muted;
                        font-family: Theme.font-ui;
                        font-size: Theme.text-sm;
                        vertical-alignment: center;
                        visible: !Theme.compact;
                    }

                    // Drag region.
                    WindowMoveArea { horizontal-stretch: 1; }

                    // Engine state is always visible, in every phase.
                    Badge {
                        text: Backend.phase-text;
                        dot: true;
                        dot-color: root.running ? Theme.signal-device
                            : root.failed ? Theme.danger
                            : Theme.text-faint;
                        fg: root.running ? Theme.signal-device
                            : root.failed ? Theme.danger
                            : Theme.text-muted;
                        bg: root.running ? Theme.signal-device-soft
                            : root.failed ? Theme.danger-soft
                            : Theme.surface-3;
                        y: (parent.height - self.height) / 2;
                    }

                    IconButton {
                        icon: @image-url("icons/win-min.svg");
                        y: (parent.height - self.height) / 2;
                        clicked => { root.minimize(); }
                    }
                    IconButton {
                        icon: @image-url("icons/win-max.svg");
                        y: (parent.height - self.height) / 2;
                        clicked => { root.toggle-maximize(); }
                    }
                    IconButton {
                        icon: @image-url("icons/win-close.svg");
                        tint: Theme.text-muted;
                        hover-bg: Theme.danger;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.close-window(); }
                    }
                }
            }

            // ---------------- Body ----------------
            HorizontalLayout {
                // Navigation rail.
                Rectangle {
                    width: Theme.rail-width;
                    background: Theme.sidebar;
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: Theme.border;
                    }
                    VerticalLayout {
                        padding: Theme.space-3;
                        spacing: 2px;

                        RailLabel { text: "工作区"; }
                        NavItem {
                            label: "监控路由";
                            icon: @image-url("icons/route.svg");
                            active: root.page == 0;
                            clicked => { root.page = 0; }
                        }
                        NavItem {
                            label: "测试音";
                            icon: @image-url("icons/wave.svg");
                            active: root.page == 1;
                            clicked => { root.page = 1; }
                        }
                        NavItem {
                            label: "音频设备";
                            icon: @image-url("icons/devices.svg");
                            active: root.page == 2;
                            clicked => { root.page = 2; }
                        }

                        Rectangle { vertical-stretch: 1; }

                        RailLabel { text: "系统"; }
                        NavItem {
                            label: "设置";
                            icon: @image-url("icons/settings.svg");
                            active: root.page == 3;
                            clicked => { root.page = 3; }
                        }
                    }
                }

                // Routed content. The page scrolls only when it is genuinely
                // taller than the viewport (very small window or long lists).
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.window-bg;
                    content-scroll := ScrollView {
                        VerticalLayout {
                            width: content-scroll.visible-width;
                            padding: Theme.gutter;
                            if root.page == 0: MonitorPage { }
                            if root.page == 1: RenderPage { }
                            if root.page == 2: DevicesPage { }
                            if root.page == 3: SettingsPage { exit-app => { root.exit-app(); } }
                        }
                    }
                }
            }

            // ---------------- Status bar ----------------
            Rectangle {
                height: Theme.statusbar-height;
                background: Theme.titlebar;
                Rectangle {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 1px;
                    background: Theme.hairline;
                }
                HorizontalLayout {
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    spacing: Theme.space-3;

                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 4px;
                        y: (parent.height - self.height) / 2;
                        background: root.running ? Theme.signal-device
                            : root.failed ? Theme.danger
                            : Theme.text-faint;
                    }
                    Text {
                        text: "引擎 " + Backend.phase-text;
                        color: Theme.text-muted;
                        font-family: Theme.font-ui;
                        font-size: Theme.text-sm;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 1px;
                        height: 14px;
                        background: Theme.border;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "已运行";
                        color: Theme.text-faint;
                        font-family: Theme.font-ui;
                        font-size: Theme.text-sm;
                        vertical-alignment: center;
                    }
                    Text {
                        text: Backend.elapsed;
                        color: Theme.text;
                        font-family: Theme.font-mono;
                        font-size: Theme.text-sm;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if root.has-diagnostics: Text {
                        text: root.diagnostics;
                        color: root.failed || Backend.error-text != "" ? Theme.danger : Theme.warning;
                        font-family: Theme.font-ui;
                        font-size: Theme.text-sm;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 2;
                    }
                    Text {
                        text: "Moiren v0.1.0";
                        color: Theme.text-faint;
                        font-family: Theme.font-mono;
                        font-size: Theme.text-xs;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
