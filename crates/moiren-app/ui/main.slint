// Moiren — application shell adapted from the Figma v0.1.0 studio layout.
//
// Bands: application toolbar 44px / studio body / engine status bar 28px.
//
// Adaptive strategy:
//   * The body is one HorizontalLayout: fixed-width side panels around a
//     canvas that flexes (horizontal-stretch: 1). Any window size gets a
//     working canvas.
//   * Breakpoints (Theme tokens, driven by the published viewport width):
//       >= 1280px  everything docked (library 210 · canvas · inspector 280)
//       <  1280px  inspector collapses; a toggle reopens it as a right
//                  flyout overlay with a click-away scrim
//       <  1100px  library also collapses; left flyout on demand (Ctrl+K
//                  opens it too)
//   * Flyouts are siblings *after* the body inside the same clipped
//     Rectangle, so they overlay the canvas instead of squeezing it.
//   * The toolbar/status bar reflow their inner clusters via stretch
//     spacers and Theme.compact conditionals (see pages/studio-chrome.slint).
//
// The shell remains the single publisher of window geometry to
// Theme.viewport-*, so every token and panel branches on real size.

export { AppTray } from "tray.slint";
export {
    Backend,
    BackendPhase,
    AudioEndpoint,
    ProcessSource,
    LibraryEntry,
    GraphNodeData,
    GraphWireData,
} from "backend.slint";
import { Backend } from "backend.slint";
import { Theme } from "theme.slint";
import { AppToolbar, EngineStatusbar } from "pages/studio-chrome.slint";
import { NodeLibrary } from "pages/node-library.slint";
import { GraphCanvas } from "pages/graph-canvas.slint";
import { ConnectionInspector } from "pages/connection-inspector.slint";
import { MixerPage } from "pages/mixer.slint";
export { SignalRect, MeterRegion } from "components/signal-meter.slint";
import {
    SignalRect,
    MeterRegion,
    MeterDefaults,
} from "components/signal-meter.slint";

export component MainWindow inherits Window {
    title: "Moiren";
    no-frame: true;
    background: Theme.window-bg;
    min-width: 940px;
    min-height: 600px;
    preferred-width: 1600px;
    preferred-height: 956px;
    forward-focus: shell-focus;
    private property <MeterRegion> docked-output;
    private property <MeterRegion> docked-input;
    private property <MeterRegion> flyout-output;
    private property <MeterRegion> flyout-input;
    out property <[MeterRegion]> output-meter-regions: [
        Theme.inspector-collapsed ? (root.inspector-flyout-open ? root.flyout-output : MeterDefaults.hidden) : root.docked-output,
        Backend.view == 1 ? mix-view.output-region : MeterDefaults.hidden,
        Backend.view == 0 ? graph-view.output-region : MeterDefaults.hidden,
    ];
    out property <[MeterRegion]> input-meter-regions: [
        Theme.inspector-collapsed ? (root.inspector-flyout-open ? root.flyout-input : MeterDefaults.hidden) : root.docked-input,
        Backend.view == 1 ? mix-view.input-region : MeterDefaults.hidden,
        Backend.view == 0 ? graph-view.input-region : MeterDefaults.hidden,
    ];
    out property <SignalRect> meter-body-clip: {
        left: body.absolute-position.x / 1px,
        top: body.absolute-position.y / 1px,
        width: body.width / 1px,
        height: body.height / 1px,
    };
    changed output-meter-regions => { Backend.presentation-changed(); }
    changed input-meter-regions => { Backend.presentation-changed(); }
    changed meter-body-clip => { Backend.presentation-changed(); }

    // Publish geometry to the theme for size-class tokens.
    in-out property <length> shell-width: self.width;
    in-out property <length> shell-height: self.height;
    changed shell-width => { Theme.viewport-width = self.shell-width; }
    changed shell-height => { Theme.viewport-height = self.shell-height; }
    init => {
        Theme.viewport-width = self.width;
        Theme.viewport-height = self.height;
    }

    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback exit-app();
    if Backend.signal-debug != "": signal-debug-text := Text {
        text: Backend.signal-debug;
        width: 0px;
        height: 0px;
        opacity: 0;
        accessible-role: text;
        accessible-label: Backend.signal-debug;
    }

    // Flyout state for collapsed panels.
    in-out property <bool> library-flyout-open: false;
    in-out property <bool> inspector-flyout-open: false;
    in-out property <string> library-filter: "";

    shell-focus := FocusScope {
        // Ctrl+K: open library (and its flyout when collapsed).
        // Esc: close any open flyout.
        capture-key-pressed(e) => {
            if (e.text == "k" && (e.modifiers.control || e.modifiers.meta)) {
                if (Theme.library-collapsed) {
                    root.library-flyout-open = true;
                }
                accept
            } else if (e.text == "q" && (e.modifiers.control || e.modifiers.meta)) {
                root.exit-app();
                accept
            } else if (e.text == Key.Escape) {
                if (root.library-flyout-open || root.inspector-flyout-open) {
                    root.library-flyout-open = false;
                    root.inspector-flyout-open = false;
                    accept
                } else { reject }
            } else { reject }
        }

        Rectangle {
            background: Theme.window-bg;
            clip: true;

            VerticalLayout {
                // ---------------- Application toolbar ----------------
                AppToolbar {
                    view <=> Backend.view;
                    minimize => { root.minimize(); }
                    toggle-maximize => { root.toggle-maximize(); }
                    close-window => { root.close-window(); }
                }

                // ---------------- Studio body ----------------
                body := Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    HorizontalLayout {
                        // Docked library (wide layouts only).
                        if !Theme.library-collapsed: NodeLibrary {
                            width: Theme.library-width;
                            horizontal-stretch: 0;
                            filter <=> root.library-filter;
                        }

                        // Canvas: the only flexing child.
                        Rectangle {
                            horizontal-stretch: 1;
                            clip: true;
                            VerticalLayout {
                                if Backend.error-text != "" || Backend.catalog-error != "": Rectangle {
                                    height: 54px;
                                    background: Theme.surface-3;
                                    HorizontalLayout {
                                        padding: 12px;
                                        Text {
                                            text: Backend.error-text != "" ? Backend.error-text : Backend.catalog-error;
                                            color: Theme.danger;
                                            font-family: Theme.font-ui;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                    graph-view := GraphCanvas {
                                        visible: Backend.view == 0;
                                        meters-visible: !(root.library-flyout-open && Theme.library-collapsed)
                                            && !(root.inspector-flyout-open && Theme.inspector-collapsed);
                                    }

                                    mix-view := MixerPage {
                                        visible: Backend.view == 1;
                                    }
                                }
                            }
                        }

                        // Docked inspector.
                        if !Theme.inspector-collapsed: ConnectionInspector {
                            width: Theme.inspector-width;
                            horizontal-stretch: 0;
                            regions-changed(output, input) => {
                                root.docked-output = output;
                                root.docked-input = input;
                            }
                        }
                    }

                    // --- Narrow flyouts (overlay above the canvas). ---
                    if root.library-flyout-open && Theme.library-collapsed: Rectangle {
                        x: 0;
                        y: 0;
                        width: Theme.library-width;
                        height: 100%;
                        NodeLibrary {
                            filter <=> root.library-filter;
                        }

                        Rectangle {
                            x: parent.width;
                            width: body.width - parent.width;
                            height: 100%;
                            background: Theme.overlay-scrim;
                            TouchArea {
                                clicked => { root.library-flyout-open = false; }
                            }
                        }
                    }
                    if root.inspector-flyout-open && Theme.inspector-collapsed: Rectangle {
                        x: body.width - Theme.inspector-width;
                        y: 0;
                        width: Theme.inspector-width;
                        height: 100%;
                        ConnectionInspector {
                            regions-changed(output, input) => {
                                root.flyout-output = output;
                                root.flyout-input = input;
                            }
                        }

                        Rectangle {
                            x: -1 * (body.width - Theme.inspector-width);
                            width: body.width - Theme.inspector-width;
                            height: 100%;
                            background: Theme.overlay-scrim;
                            TouchArea {
                                clicked => { root.inspector-flyout-open = false; }
                            }
                        }
                    }

                    // Collapse toggles float at the panel edges when the
                    // corresponding panel is hidden.
                    if Theme.inspector-collapsed && !root.inspector-flyout-open: Rectangle {
                        x: body.width - 30px;
                        y: 12px;
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: insp-toggle-ta.has-hover ? Theme.surface-3 : Theme.surface-2;
                        border-width: 1px;
                        border-color: Theme.border;
                        Image {
                            source: @image-url("icons/sliders.svg");
                            colorize: Theme.text-muted;
                            width: 14px;
                            height: 14px;
                        }

                        insp-toggle-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.inspector-flyout-open = !root.inspector-flyout-open; }
                        }
                    }
                    if Theme.library-collapsed && !root.library-flyout-open: Rectangle {
                        x: 12px;
                        y: 12px;
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: lib-toggle-ta.has-hover ? Theme.surface-3 : Theme.surface-2;
                        border-width: 1px;
                        border-color: Theme.border;
                        Image {
                            source: @image-url("icons/search.svg");
                            colorize: Theme.text-muted;
                            width: 14px;
                            height: 14px;
                        }

                        lib-toggle-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.library-flyout-open = !root.library-flyout-open; }
                        }
                    }
                }

                // ---------------- Engine status bar ----------------
                EngineStatusbar { }
            }
        }
    }
}
