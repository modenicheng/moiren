// Reusable, fully themed building blocks. Nothing here hard-codes a color —
// everything reads from `Theme`, so a theme switch restyles the whole app.

import { Theme } from "theme.slint";

// ---------------------------------------------------------------------------
// Surfaces
// ---------------------------------------------------------------------------

export component Card inherits Rectangle {
    in property <bool> raised: false;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-color: raised ? Theme.shadow : transparent;
    drop-shadow-blur: Theme.shadow-blur;
    drop-shadow-offset-y: 6px;
    @children
}

export component SectionLabel inherits Text {
    color: Theme.text-faint;
    font-size: Theme.text-xs;
    font-weight: Theme.weight-semibold;
    letter-spacing: 0.6px;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// ---------------------------------------------------------------------------
// Badge / status pill
// ---------------------------------------------------------------------------

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.text-muted;
    in property <color> bg: Theme.surface-3;
    in property <bool> dot: false;
    in property <color> dot-color: fg;
    height: 24px;
    border-radius: Theme.radius-pill;
    background: bg;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;
        if dot: Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: dot-color;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: fg;
            font-size: Theme.text-xs;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }
}

// ---------------------------------------------------------------------------
// Buttons
// ---------------------------------------------------------------------------

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 46px;
    horizontal-stretch: 0;
    min-width: content.min-width + 2 * Theme.space-5;
    border-radius: Theme.radius-md;
    opacity: enabled ? 1.0 : 0.45;

    border-width: primary || danger ? 0px : 1px;
    border-color: Theme.border-strong;

    background:
        primary ? (ta.pressed ? Theme.primary-pressed : ta.has-hover ? Theme.primary-hover : Theme.primary)
        : danger ? (ta.pressed ? Theme.danger.darker(0.15) : ta.has-hover ? Theme.danger.brighter(0.08) : Theme.danger)
        : (ta.pressed ? Theme.surface-3 : ta.has-hover ? Theme.surface-2 : Theme.surface);
    animate background { duration: Theme.fast; }

    property <color> label-color: primary || danger ? Theme.on-primary : Theme.text;

    content := HorizontalLayout {
        padding-left: Theme.space-5;
        padding-right: Theme.space-5;
        spacing: Theme.space-2;
        alignment: center;
        if root.icon.width > 0: Image {
            source: root.icon;
            colorize: root.label-color;
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.label-color;
            font-size: Theme.text-sm;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.text-muted;
    in property <color> hover-bg: Theme.surface-3;
    in property <length> size: 36px;
    in property <bool> enabled: true;
    callback clicked();

    width: size;
    height: size;
    border-radius: Theme.radius-sm;
    opacity: enabled ? 1.0 : 0.4;
    background: ta.pressed ? hover-bg.darker(0.1) : ta.has-hover ? hover-bg : transparent;
    animate background { duration: Theme.fast; }

    Image {
        source: root.icon;
        colorize: ta.has-hover ? Theme.text : root.tint;
        width: root.size * 0.52;
        height: root.size * 0.52;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---------------------------------------------------------------------------
// Toggle switch
// ---------------------------------------------------------------------------

export component AppToggle inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);
    width: 46px;
    height: 26px;
    border-radius: self.height / 2;
    background: checked ? Theme.primary : Theme.surface-3;
    animate background { duration: Theme.fast; }

    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: self.width / 2;
        y: (parent.height - self.height) / 2;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        background: #ffffff;
        drop-shadow-color: #00000040;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
        animate x { duration: Theme.fast; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// ---------------------------------------------------------------------------
// Slider
// ---------------------------------------------------------------------------

export component AppSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value: 0.5;
    in property <bool> bipolar: false;   // fill grows from center (pan)
    callback changed(float);

    height: 24px;
    horizontal-stretch: 1;

    property <length> track-h: 6px;
    property <length> knob: 18px;
    property <float> frac: ((value - minimum) / max(0.0001, maximum - minimum)).clamp(0, 1);
    property <length> usable: self.width - knob;

    // Track
    Rectangle {
        y: (parent.height - root.track-h) / 2;
        x: root.knob / 2;
        width: parent.width - root.knob;
        height: root.track-h;
        border-radius: self.height / 2;
        background: Theme.surface-3;

        // Filled portion
        Rectangle {
            y: 0;
            height: 100%;
            border-radius: self.height / 2;
            background: Theme.brand-gradient;
            x: root.bipolar ? (root.frac < 0.5 ? parent.width * root.frac : parent.width * 0.5)
                : 0;
            width: root.bipolar
                ? parent.width * abs(root.frac - 0.5)
                : parent.width * root.frac;
        }
    }

    // Knob
    Rectangle {
        width: root.knob;
        height: root.knob;
        border-radius: self.width / 2;
        y: (parent.height - self.height) / 2;
        x: root.frac * root.usable;
        background: #ffffff;
        border-width: 2px;
        border-color: Theme.primary;
        drop-shadow-color: #00000038;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 1px;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        property <float> f: ((self.mouse-x - root.knob / 2) / max(1px, root.usable)).clamp(0, 1);
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.value = root.minimum + self.f * (root.maximum - root.minimum);
                root.changed(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                root.value = root.minimum + self.f * (root.maximum - root.minimum);
                root.changed(root.value);
            }
        }
    }
}

// A labeled slider row: title on the left, read-out on the right, slider below.
export component ControlRow inherits VerticalLayout {
    in property <string> title;
    in property <string> readout;
    in property <image> icon;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <bool> bipolar: false;
    in-out property <float> value;
    callback changed(float);
    spacing: Theme.space-2;

    HorizontalLayout {
        spacing: Theme.space-2;
        if root.icon.width > 0: Image {
            source: root.icon;
            colorize: Theme.text-muted;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.title;
            color: Theme.text-muted;
            font-size: Theme.text-sm;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
        }
        Rectangle { }
        Text {
            text: root.readout;
            color: Theme.text;
            font-size: Theme.text-sm;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }
    slider := AppSlider {
        minimum: root.minimum;
        maximum: root.maximum;
        bipolar: root.bipolar;
        value <=> root.value;
        changed(v) => { root.changed(v); }
    }
}

// ---------------------------------------------------------------------------
// Select / dropdown
// ---------------------------------------------------------------------------

export struct SelectOption {
    text: string,
    detail: string,
}

export component AppSelect inherits Rectangle {
    in property <[SelectOption]> options;
    in property <image> icon;
    in property <string> placeholder: "选择…";
    in-out property <int> current: 0;
    callback selected(int);

    height: 56px;
    border-radius: Theme.radius-md;
    background: ta.has-hover ? Theme.surface-2 : Theme.surface;
    border-width: 1px;
    border-color: popup-open ? Theme.primary : Theme.border-strong;
    animate border-color { duration: Theme.fast; }

    property <bool> popup-open: false;
    property <bool> has-value: current >= 0 && current < options.length;

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-3;

        if root.icon.width > 0: Rectangle {
            width: 36px;
            background: Theme.primary-soft;
            border-radius: Theme.radius-sm;
            y: (parent.height - self.height) / 2;
            height: 36px;
            Image {
                source: root.icon;
                colorize: Theme.primary;
                width: 20px;
                height: 20px;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.has-value ? root.options[root.current].text : root.placeholder;
                color: root.has-value ? Theme.text : Theme.text-faint;
                font-size: Theme.text-md;
                font-weight: Theme.weight-semibold;
                overflow: elide;
            }
            if root.has-value && root.options[root.current].detail != "": Text {
                text: root.options[root.current].detail;
                color: Theme.text-muted;
                font-size: Theme.text-xs;
                overflow: elide;
            }
        }

        Image {
            source: @image-url("icons/chevron.svg");
            colorize: Theme.text-muted;
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            transform-rotation: root.popup-open ? 180deg : 0deg;
            animate transform-rotation { duration: Theme.fast; }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); root.popup-open = true; }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: root.width;
        height: min(300px, root.options.length * 52px + 2 * Theme.space-2);
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.surface-2;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.shadow-blur;
            drop-shadow-offset-y: 10px;

            Flickable {
                VerticalLayout {
                    padding: Theme.space-2;
                    spacing: 2px;
                    for opt[i] in root.options: Rectangle {
                        height: 48px;
                        border-radius: Theme.radius-sm;
                        background: i == root.current ? Theme.primary-soft
                            : row-ta.has-hover ? Theme.surface-3 : transparent;
                        HorizontalLayout {
                            padding-left: Theme.space-3;
                            padding-right: Theme.space-3;
                            spacing: Theme.space-2;
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: opt.text;
                                    color: i == root.current ? Theme.primary : Theme.text;
                                    font-size: Theme.text-sm;
                                    font-weight: Theme.weight-semibold;
                                    overflow: elide;
                                }
                                if opt.detail != "": Text {
                                    text: opt.detail;
                                    color: Theme.text-muted;
                                    font-size: Theme.text-xs;
                                    overflow: elide;
                                }
                            }
                            Rectangle { }
                            if i == root.current: Image {
                                source: @image-url("icons/check.svg");
                                colorize: Theme.primary;
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.current = i;
                                root.selected(i);
                                root.popup-open = false;
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Stereo level meter
// ---------------------------------------------------------------------------

component MeterChannel inherits Rectangle {
    in property <string> label;
    in property <float> level;    // 0..1
    in property <float> peak;     // 0..1
    height: 14px;
    HorizontalLayout {
        spacing: Theme.space-2;
        Text {
            text: root.label;
            color: Theme.text-faint;
            font-size: Theme.text-xs;
            font-weight: Theme.weight-semibold;
            width: 12px;
            vertical-alignment: center;
        }
        track := Rectangle {
            border-radius: 4px;
            background: Theme.surface-3;
            clip: true;
            // Level fill with low/mid/high gradient
            Rectangle {
                x: 0;
                width: parent.width * root.level.clamp(0, 1);
                background: @linear-gradient(90deg,
                    Theme.meter-low 0%,
                    Theme.meter-low 65%,
                    Theme.meter-mid 85%,
                    Theme.meter-high 100%);
                animate width { duration: 80ms; }
            }
            // Peak hold tick
            Rectangle {
                width: 2px;
                x: (parent.width - self.width) * root.peak.clamp(0, 1);
                background: Theme.text;
                opacity: 0.8;
            }
        }
    }
}

export component StereoMeter inherits VerticalLayout {
    in property <float> left;
    in property <float> right;
    in property <float> peak-left;
    in property <float> peak-right;
    spacing: Theme.space-2;
    MeterChannel { label: "L"; level: root.left; peak: root.peak-left; }
    MeterChannel { label: "R"; level: root.right; peak: root.peak-right; }
}

// ---------------------------------------------------------------------------
// Small stat tile
// ---------------------------------------------------------------------------

export component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> accent: Theme.text;
    background: Theme.surface-2;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    vertical-stretch: 0;
    VerticalLayout {
        padding: Theme.space-3;
        spacing: 4px;
        Text {
            text: root.label;
            color: Theme.text-faint;
            font-size: Theme.text-xs;
            font-weight: Theme.weight-semibold;
        }
        Text {
            text: root.value;
            color: root.accent;
            font-size: Theme.text-lg;
            font-weight: Theme.weight-bold;
        }
    }
}
