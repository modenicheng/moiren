// Development-only preview: renders the studio shell with the Figma sample
// scene inline, so `slint-viewer ui/dev-preview.slint` shows the full graph
// without the Rust backend. NOT compiled into the app (build.rs targets
// main.slint). Sample data belongs only to this preview.

import { Backend, BackendPhase, LibraryEntry, GraphNodeData, GraphWireData } from "backend.slint";
import { MainWindow as Shell } from "main.slint";

