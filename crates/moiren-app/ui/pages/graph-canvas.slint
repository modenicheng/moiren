// Signal graph canvas — the flex center column. Owns pan/zoom state and
// renders Backend.graph-nodes / Backend.graph-wires above a 24px grid.
//
// Adaptive: the canvas fills whatever the shell gives it (it is the only
// horizontal-stretch child of the studio body). Pan/zoom let the same
// canvas serve every window width.

import { Theme } from "../theme.slint";
import { Backend } from "../backend.slint";
import { SignalRect, MeterRegion, MeterDefaults } from "../components/signal-meter.slint";
import { GraphNodeCard, GraphWire, GraphCardMetrics } from "../components/graph.slint";
import { StudioButton } from "../components/studio-controls.slint";

// Floating edit toolbar: Select / Pan + zoom readout.
component EditingToolbar inherits Rectangle {
    in property <int> tool;
    in property <float> zoom;
    callback tool-changed(int);
    callback zoom-changed(float);
    width: 284px;
    height: 30px;
    background: transparent;

    HorizontalLayout {
        spacing: 7px;
        StudioButton {
            text: "Select";
            icon: "arrow-up-left";
            width: 86px;
            active: root.tool == 0;
            clicked => { root.tool-changed(0); }
        }
        StudioButton {
            text: "Pan";
            icon: "hand-move";
            width: 72px;
            active: root.tool == 1;
            clicked => { root.tool-changed(1); }
        }
        Rectangle {
            width: 112px;
            height: 30px;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface-3;
            HorizontalLayout {
                spacing: 0px;
                zoom-out := Rectangle {
                    width: 30px;
                    background: minus-ta.has-hover && root.zoom > 0.25 ? Theme.surface-4 : transparent;
                    Text { text: "−"; color: root.zoom > 0.25 ? Theme.text : Theme.text-faint; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    minus-ta := TouchArea {
                        enabled: root.zoom > 0.25;
                        mouse-cursor: pointer;
                        clicked => { root.zoom-changed(max(0.25, root.zoom / 1.05)); }
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: round(root.zoom * 100) + "%";
                    color: Theme.text;
                    font-family: Theme.font-ui;
                    font-size: 12px;
                    font-weight: Theme.weight-medium;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                zoom-in := Rectangle {
                    width: 30px;
                    background: plus-ta.has-hover && root.zoom < 2 ? Theme.surface-4 : transparent;
                    Text { text: "+"; color: root.zoom < 2 ? Theme.text : Theme.text-faint; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    plus-ta := TouchArea {
                        enabled: root.zoom < 2;
                        mouse-cursor: pointer;
                        clicked => { root.zoom-changed(min(2, root.zoom * 1.05)); }
                    }
                }
            }
        }
    }
}

export component GraphCanvas inherits Rectangle {
    background: Theme.window-bg;
    in property <bool> meters-visible: true;
    private property <SignalRect> meter-viewport: {
        left: root.absolute-position.x / 1px, top: root.absolute-position.y / 1px,
        width: root.width / 1px, height: root.height / 1px,
    };
    out property <MeterRegion> input-region: root.meter-region(Backend.graph-input-index);
    out property <MeterRegion> output-region: root.meter-region(Backend.graph-output-index);
    pure function meter-region(index: int) -> MeterRegion {
        if (index < 0 || index >= Backend.graph-nodes.length) { return MeterDefaults.hidden; }
        let node = Backend.graph-nodes[index];
        return {
            enabled: root.visible && root.meters-visible,
            bounds: {
                left: root.meter-viewport.left + (root.pan-x + (node.x + GraphCardMetrics.padding) * root.zoom) / 1px,
                top: root.meter-viewport.top + (root.pan-y + (node.y + GraphCardMetrics.meter-y) * root.zoom) / 1px,
                width: max(0px, node.card-width - 2 * GraphCardMetrics.padding) / 1px * root.zoom,
                height: GraphCardMetrics.meter-height / 1px * root.zoom,
            },
            viewport: root.meter-viewport,
        };
    }

    // Pan & zoom (world origin at canvas top-left).
    in-out property <length> pan-x: 0px;
    in-out property <length> pan-y: 0px;
    in-out property <float> zoom: 1.0;
    in-out property <int> tool: 0;   // 0 select · 1 pan
    property <int> focus-generation: Backend.focus-generation;
    property <length> canvas-width: self.width;
    property <length> canvas-height: self.height;
    property <bool> camera-adjusted: false;
    // Keep roughly 24-48 screen pixels between grid lines. At small zoom
    // levels, a larger world step avoids creating hundreds of near-overlapping
    // rectangles while preserving the graph's world-space alignment.
    property <length> grid-world-size: Theme.canvas-grid
        * (root.zoom < 0.5 ? 4 : root.zoom < 1.0 ? 2 : 1);
    property <length> grid-screen-size: root.grid-world-size * root.zoom;
    out property <bool> space-held: false;
    out property <bool> pan-with-left: root.tool == 1 || root.space-held;
    out property <length> navigation-top: editing-toolbar.y + editing-toolbar.height + Theme.space-2;
    public function focus-canvas() { graph-focus.focus(); }
    public function cancel-input() { root.space-held = false; bg-ta.panning = false; }
    public function pan-by(delta-x: length, delta-y: length) {
        root.pan-x += delta-x;
        root.pan-y += delta-y;
        root.camera-adjusted = true;
    }
    public function zoom-by(factor: float, anchor-x: length, anchor-y: length) {
        root.zoom-at((root.zoom * factor).clamp(0.25, 2.0), anchor-x, anchor-y);
    }
    graph-focus := FocusScope {
        enabled: root.visible;
        key-pressed(event) => {
            if (event.text == " " && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                root.space-held = true;
                accept
            } else { reject }
        }
        key-released(event) => {
            if (event.text == " ") { root.space-held = false; accept } else { reject }
        }
        focus-lost => { root.cancel-input(); }
    }
    function zoom-at(next-zoom: float, anchor-x: length, anchor-y: length) {
        root.pan-x = anchor-x - (anchor-x - root.pan-x) * next-zoom / root.zoom;
        root.pan-y = anchor-y - (anchor-y - root.pan-y) * next-zoom / root.zoom;
        root.zoom = next-zoom;
        root.camera-adjusted = true;
    }
    function fit-graph() {
        let available-width = max(1px, root.width - 2 * Theme.canvas-gutter);
        let available-height = max(1px, root.height - Theme.canvas-chrome-top - Theme.canvas-chrome-bottom);
        root.zoom = min(available-width / max(1px, Backend.graph-width), available-height / max(1px, Backend.graph-height)).clamp(0.25, 1.0);
        root.pan-x = Theme.canvas-gutter + (available-width - Backend.graph-width * root.zoom) / 2 - Backend.graph-left * root.zoom;
        root.pan-y = Theme.canvas-chrome-top + (available-height - Backend.graph-height * root.zoom) / 2 - Backend.graph-top * root.zoom;
    }
    changed canvas-width => { if (!root.camera-adjusted) { root.fit-graph(); } }
    changed canvas-height => { if (!root.camera-adjusted) { root.fit-graph(); } }
    changed focus-generation => {
        root.pan-x = 64px - Backend.focus-x * root.zoom;
        root.pan-y = 150px - Backend.focus-y * root.zoom;
        root.camera-adjusted = true;
    }

    // Background interactions: pan / wheel-zoom / click-clear. Sits behind
    // node touch areas because it is declared before the world's children
    // got their own areas; nodes are on top in paint order too.
    bg-ta := TouchArea {
        property <length> grab-x;
        property <length> grab-y;
        property <bool> panning: false;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.focus-canvas();
                self.grab-x = root.pan-x - self.mouse-x;
                self.grab-y = root.pan-y - self.mouse-y;
                if (e.button == PointerEventButton.middle || (e.button == PointerEventButton.left && root.pan-with-left)) {
                    self.panning = true;
                } else if (e.button == PointerEventButton.left) {
                    Backend.clear-selection();
                }
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                self.panning = false;
            }
        }
        moved => {
            if (self.panning) {
                root.camera-adjusted = true;
                root.pan-x = self.grab-x + self.mouse-x;
                root.pan-y = self.grab-y + self.mouse-y;
            }
        }
        scroll-event(e) => {
            if (e.delta-y == 0px) { return reject; }
            root.zoom-by(pow(1.02, e.delta-y / 60px), self.mouse-x, self.mouse-y);
            accept
        }
    }

    // World viewport: clip everything outside the canvas.
    viewport := Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        for column in ceil(root.width / root.grid-screen-size) + 2: Rectangle {
            x: mod(mod(root.pan-x / 1px, root.grid-screen-size / 1px) + root.grid-screen-size / 1px, root.grid-screen-size / 1px) * 1px + (column - 1) * root.grid-screen-size;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: Theme.hairline;
        }
        for row in ceil(root.height / root.grid-screen-size) + 2: Rectangle {
            x: 0px;
            y: mod(mod(root.pan-y / 1px, root.grid-screen-size / 1px) + root.grid-screen-size / 1px, root.grid-screen-size / 1px) * 1px + (row - 1) * root.grid-screen-size;
            width: parent.width;
            height: 1px;
            background: Theme.hairline;
        }

        world := Rectangle {
            x: root.pan-x + Backend.graph-left * root.zoom;
            y: root.pan-y + Backend.graph-top * root.zoom;
            width: max(1px, Backend.graph-width);
            height: max(1px, Backend.graph-height);
            background: transparent;
            transform-scale: root.zoom;
            transform-origin: {x: 0, y: 0};

            // Wires under nodes.
            for wire in Backend.graph-wires: GraphWire {
                data: wire;
                selected: Backend.selected-wire == wire.id;
                x1: wire.x1 - Backend.graph-left; y1: wire.y1 - Backend.graph-top;
                x2: wire.x2 - Backend.graph-left; y2: wire.y2 - Backend.graph-top;
            }
            for wire in Backend.graph-wires: Rectangle {
                x: (wire.x1 + wire.x2) / 2 - Backend.graph-left - 6px;
                y: (wire.y1 + wire.y2) / 2 - Backend.graph-top - 6px;
                width: 12px; height: 12px;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.primary;
                background: Backend.selected-wire == wire.id ? Theme.primary : Theme.surface-2;
                TouchArea {
                    enabled: !root.pan-with-left;
                    mouse-cursor: pointer;
                    clicked => { root.focus-canvas(); Backend.select-wire(wire.id); }
                }
            }

            // Nodes.
            for node in Backend.graph-nodes: GraphNodeCard {
                x: node.x - Backend.graph-left;
                y: node.y - Backend.graph-top;
                data: node;
                selected: Backend.selected-node == node.id;
                is-parameter: node.type-label == "GAIN" || node.type-label == "PAN";
                level-live: node.has-input && !node.has-output ? Backend.output-meter-live : !node.has-input && node.has-output && Backend.input-meter-live;
                left-rms: node.has-input ? Backend.route-meter-l : Backend.input-meter-l;
                right-rms: node.has-input ? Backend.route-meter-r : Backend.input-meter-r;
                left-peak: node.has-input ? Backend.route-peak-l : Backend.input-peak-l;
                right-peak: node.has-input ? Backend.route-peak-r : Backend.input-peak-r;
                interactive: !root.pan-with-left;
                focused => { root.focus-canvas(); }
            }
        }
    }

    // Chrome.
    editing-toolbar := EditingToolbar {
        x: Theme.library-collapsed ? 56px : 24px;
        y: 18px;
        tool: root.tool;
        zoom: root.zoom;
        tool-changed(t) => { root.tool = t; }
        zoom-changed(z) => { root.zoom-at(z, root.width / 2, root.height / 2); }
    }
    fit-button := StudioButton {
        x: editing-toolbar.x + editing-toolbar.width + 7px;
        y: 18px;
        text: "Fit";
        width: 48px;
        clicked => { root.fit-graph(); root.camera-adjusted = false; }
    }
    Text {
        x: parent.width - self.width - (Theme.inspector-collapsed ? 60px : 24px);
        y: 24px;
        visible: root.width > 800px;
        text: "Wheel / pinch to zoom · Trackpad / Space + drag to pan";
        color: Theme.text-faint;
        font-family: Theme.font-ui;
        font-size: 10px;
    }
    Text {
        x: 24px;
        y: parent.height - 30px;
        text: "Candidate graph · Click a wire marker to inspect";
        color: Theme.text-faint;
        font-family: Theme.font-ui;
        font-size: 10px;
    }
    Text {
        x: 24px; y: 64px; width: parent.width - 48px;
        text: Backend.session-status;
        color: Theme.text-muted;
        font-family: Theme.font-ui;
        font-size: 11px;
        overflow: elide;
    }
    if Backend.selection-label != "": Text {
        x: parent.width - self.width - 24px;
        y: parent.height - 30px;
        text: Backend.selection-label;
        color: Theme.primary;
        font-family: Theme.font-ui;
        font-size: 10px;
    }
}
