import { Theme } from "../theme.slint";
import { Backend } from "../backend.slint";
import { AppSelect } from "../components/widgets.slint";
import { StudioButton, SectionHeading } from "../components/studio-controls.slint";

export component SessionSetup inherits VerticalLayout {
    vertical-stretch: 0;
    alignment: start;
    spacing: 8px;
    SectionHeading { title: "SESSION I/O"; }
    source-mode := AppSelect {
        height: 30px;
        options: [{ text: "Physical input", detail: "" }, { text: "Application audio", detail: "" }, { text: "Test tone", detail: "" }];
        current <=> Backend.source-mode;
    }
    if Backend.source-mode == 0: AppSelect {
        height: 30px;
        options: Backend.input-options;
        current <=> Backend.input-index;
        placeholder: "No input selected";
        selected(index) => { Backend.select-input(index); }
    }
    if Backend.source-mode == 1: AppSelect {
        height: 30px;
        options: Backend.process-options;
        current <=> Backend.process-index;
        placeholder: "Select an application";
        selected(index) => { Backend.select-process(index); }
    }
    if Backend.source-mode == 2: Text {
        text: "440 Hz · 10 seconds";
        color: Theme.text-muted;
        font-family: Theme.font-mono;
        font-size: 11px;
        height: 30px;
        vertical-alignment: center;
    }
    output-device := AppSelect {
        height: 30px;
        options: Backend.output-options;
        current <=> Backend.output-index;
        placeholder: "No output selected";
        selected(index) => { Backend.select-output(index); }
    }
    StudioButton {
        text: "Refresh devices";
        enabled: Backend.transport-ready;
        clicked => { Backend.refresh-catalog(); }
    }
    Text {
        text: "Device changes apply on Start.";
        color: Theme.text-faint;
        font-family: Theme.font-ui;
        font-size: 10px;
        wrap: word-wrap;
    }
    Rectangle { height: 1px; background: Theme.border; }
}
