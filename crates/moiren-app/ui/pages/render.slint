// Render page — a single centred generator/transport card.
//
// The reference keeps the whole workflow in one column: generator controls,
// transport, then progress. The card hugs its content and the page owns the
// empty canvas around it.

import { Theme } from "../theme.slint";
import { Backend } from "../backend.slint";
import {
    AppButton, AppSlider, Badge, ButtonTone, Card, PageHeader, SectionLabel,
} from "../components.slint";

// A page-local label + slider group. It keeps the three generator rows aligned
// while letting AppSlider own interaction and the progress bar use its own
// recorder-gold accent.
component SliderRow inherits VerticalLayout {
    in property <string> title;
    in property <string> readout;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <bool> bipolar: false;
    in-out property <float> value;
    callback changed(float);

    spacing: Theme.space-3;
    vertical-stretch: 0;

    HorizontalLayout {
        spacing: Theme.space-3;
        Text {
            text: root.title;
            color: Theme.text;
            font-family: Theme.font-ui;
            font-size: Theme.text-md;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.readout;
            color: Theme.text;
            font-family: Theme.font-mono;
            font-size: Theme.text-sm;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }

    AppSlider {
        minimum: root.minimum;
        maximum: root.maximum;
        bipolar: root.bipolar;
        value <=> root.value;
        changed(value) => { root.changed(value); }
    }
}

export component RenderPage inherits VerticalLayout {
    spacing: Theme.space-4;

    in-out property <float> gain <=> Backend.gain;
    in-out property <float> pan <=> Backend.pan;
    in-out property <float> frequency-t: 0.4475;

    property <float> frequency: 20 * pow(1000, root.frequency-t);
    property <bool> playing: Backend.active;

    function freq-text(value: float) -> string {
        return value >= 1000
            ? "\{Math.round(value / 100) / 10} kHz"
            : "\{Math.round(value)} Hz";
    }
    function gain-text(value: float) -> string {
        return value <= 0.001 ? "−∞ dB"
            : "\{Math.round(20 * ln(value) / ln(10.0) * 10) / 10} dB";
    }
    function pan-text(value: float) -> string {
        return value < -0.02 ? "L \{Math.round(-value * 100)}"
            : value > 0.02 ? "R \{Math.round(value * 100)}"
            : "Center";
    }

    PageHeader {
        title: "Render";
        subtitle: "Generate a static reference tone.";
        Badge {
            text: Backend.phase-text;
            y: (parent.height - self.height) / 2;
        }
    }

    VerticalLayout {
        alignment: center;
        vertical-stretch: 1;

        Card {
            width: Theme.render-card-width;
            horizontal-stretch: 0;
            vertical-stretch: 0;

            VerticalLayout {
                padding: Theme.space-6;
                spacing: Theme.space-5;

                SectionLabel { text: "Render Controls"; }

                SliderRow {
                    title: "Frequency";
                    readout: root.freq-text(root.frequency);
                    minimum: 0;
                    maximum: 1;
                    value <=> root.frequency-t;
                }
                SliderRow {
                    title: "Gain";
                    readout: root.gain-text(root.gain);
                    minimum: 0;
                    maximum: 1;
                    value <=> root.gain;
                    changed(value) => { Backend.set-gain-pan(value, root.pan); }
                }
                SliderRow {
                    title: "Pan";
                    readout: root.pan-text(root.pan);
                    minimum: -1;
                    maximum: 1;
                    bipolar: true;
                    value <=> root.pan;
                    changed(value) => { Backend.set-gain-pan(root.gain, value); }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.space-5;
                    AppButton {
                        text: "Play";
                        tone: ButtonTone.primary;
                        enabled: Backend.transport-ready && !root.playing && Backend.tone-valid;
                        clicked => { Backend.start-tone(root.frequency, 8); }
                    }
                    AppButton {
                        text: "Stop";
                        enabled: root.playing && Backend.transport-ready;
                        clicked => { Backend.stop(); }
                    }
                }

                VerticalLayout {
                    spacing: Theme.space-3;
                    Text {
                        text: "Progress";
                        color: Theme.text;
                        font-family: Theme.font-ui;
                        font-size: Theme.text-md;
                    }
                    Rectangle {
                        height: Theme.space-2;
                        border-radius: Theme.radius-pill;
                        background: Theme.surface-3;
                        clip: true;

                        Rectangle {
                            x: 0;
                            width: parent.width * 0.28;
                            height: 100%;
                            border-radius: parent.height / 2;
                            background: Theme.signal-recorder;
                        }
                    }
                    Text {
                        text: "00:02.4 / 00:08.0";
                        color: Theme.text-muted;
                        font-family: Theme.font-mono;
                        font-size: Theme.text-md;
                    }
                }
            }
        }
    }
}
