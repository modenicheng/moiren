// Devices page — endpoint lists plus an always-present detail inspector.
//
// The service supplies the real endpoint catalog. The Figma reference shows a
// selected row in each list and a fixed detail panel; until the UI service can
// resolve those extra endpoint facts, the panel shows the selected device and
// explicit em dashes rather than invented values.

import { Theme } from "../theme.slint";
import { Backend, AudioEndpoint } from "../backend.slint";
import { Card, PageHeader, SectionLabel } from "../components.slint";

// A compact list row. Selection edges use the side's signal hue so input and
// output selection remain distinguishable without introducing another accent.
component DeviceRow inherits Rectangle {
    in property <AudioEndpoint> ep;
    in property <bool> capture: true;
    in property <bool> selected: false;
    in property <int> ep-index: -1;
    callback row-clicked(int);

    height: Theme.device-row-height;
    horizontal-stretch: 1;
    border-radius: Theme.radius-md;
    background: selected ? Theme.surface-4
        : row-ta.has-hover ? Theme.surface-3 : Theme.surface-4;
    border-width: 1px;
    border-color: selected
        ? (capture ? Theme.signal-device : Theme.signal-recorder)
        : Theme.border;
    animate background, border-color { duration: Theme.fast; }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.ep.name;
                color: Theme.text;
                font-family: Theme.font-ui;
                font-size: Theme.text-md;
                font-weight: Theme.weight-medium;
                overflow: elide;
            }
            Text {
                text: root.ep.channels > 0
                    ? "\{root.ep.channels} " + (root.capture ? "in" : "out")
                    : (root.capture ? "in" : "out");
                color: Theme.text-faint;
                font-family: Theme.font-ui;
                font-size: Theme.text-xs;
            }
        }
    }

    row-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.row-clicked(root.ep-index); }
    }
}

// Input or output list. The header intentionally uses the design's quiet
// micro-label rather than large group titles.
component DeviceGroup inherits Card {
    in property <string> title;
    in property <[AudioEndpoint]> items;
    in property <bool> capture: true;
    in-out property <int> selected-index: -1;

    vertical-stretch: 1;

    VerticalLayout {
        padding: Theme.card-pad;
        spacing: Theme.device-row-gap;

        SectionLabel { text: root.title; }

        for ep[i] in root.items: DeviceRow {
            ep: ep;
            ep-index: i;
            capture: root.capture;
            selected: i == root.selected-index;
            row-clicked(i) => { root.selected-index = i; }
        }

        Rectangle { vertical-stretch: 1; }
    }
}

export component DevicesPage inherits VerticalLayout {
    spacing: Theme.block-gap;

    // The lists start with the service's routing selection when it exists;
    // clicking a row still changes the local reference detail independently.
    in-out property <int> input-detail: Backend.input-index >= 0 ? Backend.input-index : 0;
    in-out property <int> output-detail: Backend.output-index >= 0 ? Backend.output-index : 0;

    property <bool> input-ok: input-detail >= 0 && input-detail < Backend.inputs.length;
    property <bool> output-ok: output-detail >= 0 && output-detail < Backend.outputs.length;
    property <AudioEndpoint> detail: root.output-ok
        ? Backend.outputs[root.output-detail]
        : (root.input-ok ? Backend.inputs[root.input-detail]
            : { id: "", name: "No Device", kind: "speaker", sample-rate: 0,
                channels: 0, format-supported: false, is-default: false, note: "" });
    property <string> channel-text:
        root.input-ok && Backend.inputs[root.input-detail].channels > 0
            ? "\{Backend.inputs[root.input-detail].channels} in"
            : (root.output-ok && Backend.outputs[root.output-detail].channels > 0
                ? "\{Backend.outputs[root.output-detail].channels} out" : "—");

    function rate-text(rate: int) -> string {
        return rate > 0 ? "\{rate / 1000.0} kHz" : "—";
    }
    function format-text(supported: bool, rate: int) -> string {
        return supported ? "\{rate / 1000.0} kHz" : "—";
    }

    PageHeader {
        title: "Devices";
        subtitle: "Select an input or output to inspect its endpoint details.";
    }

    GridLayout {
        spacing: Theme.block-gap;

        Row {
            DeviceGroup {
                max-width: Theme.device-list-max;
                title: "Input Devices";
                items: Backend.inputs;
                capture: true;
                selected-index <=> root.input-detail;
            }
            DeviceGroup {
                max-width: Theme.device-list-max;
                title: "Output Devices";
                items: Backend.outputs;
                capture: false;
                selected-index <=> root.output-detail;
            }
            Card {
                max-width: Theme.device-detail-width;
                VerticalLayout {
                    padding: Theme.card-pad;
                    spacing: Theme.space-4;

                    SectionLabel { text: "Device Details"; }
                    Text {
                        text: root.detail.name;
                        color: Theme.text;
                        font-family: Theme.font-ui;
                        font-size: Theme.text-xl;
                        font-weight: Theme.weight-semibold;
                        overflow: elide;
                    }

                    VerticalLayout {
                        spacing: Theme.space-3;
                        HorizontalLayout {
                            spacing: Theme.space-5;
                            Text {
                                text: "Sample Rate";
                                color: Theme.text-muted;
                                font-family: Theme.font-ui;
                                font-size: Theme.text-md;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: root.rate-text(root.detail.sample-rate);
                                color: Theme.text;
                                font-family: Theme.font-mono;
                                font-size: Theme.text-md;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-5;
                            Text {
                                text: "Buffer Size";
                                color: Theme.text-muted;
                                font-family: Theme.font-ui;
                                font-size: Theme.text-md;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: "—"; color: Theme.text; font-family: Theme.font-mono; font-size: Theme.text-md; }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-5;
                            Text {
                                text: "Bit Depth";
                                color: Theme.text-muted;
                                font-family: Theme.font-ui;
                                font-size: Theme.text-md;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: root.detail.format-supported ? "24-bit" : "—";
                                color: Theme.text;
                                font-family: Theme.font-mono;
                                font-size: Theme.text-md;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-5;
                            Text {
                                text: "Channels";
                                color: Theme.text-muted;
                                font-family: Theme.font-ui;
                                font-size: Theme.text-md;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: root.channel-text;
                                color: Theme.text;
                                font-family: Theme.font-mono;
                                font-size: Theme.text-md;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-5;
                            Text {
                                text: "Latency";
                                color: Theme.text-muted;
                                font-family: Theme.font-ui;
                                font-size: Theme.text-md;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: "—"; color: Theme.text; font-family: Theme.font-mono; font-size: Theme.text-md; }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }

    Text {
        text: "\{Backend.inputs.length} input devices · \{Backend.outputs.length} output devices";
        color: Theme.text-faint;
        font-family: Theme.font-ui;
        font-size: Theme.text-sm;
    }
}
