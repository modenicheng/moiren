// Monitor page — the simplified Figma routing canvas.
//
// The source rail selects which source is highlighted on the canvas; the real
// Backend properties remain authoritative for service state. This page avoids
// transport controls because the reference is a read-only topology preview.

import { Theme } from "../theme.slint";
import { Backend } from "../backend.slint";
import { SectionLabel } from "../components.slint";

// Canvas node. The compact node geometry is deliberately smaller than the
// generic graph widget because this page previews one linear chain.
component RouteNode inherits Rectangle {
    in property <string> title;
    in property <string> meta;
    in property <color> tint: Theme.text-muted;
    in property <bool> selected: false;

    width: Theme.route-node-width;
    height: Theme.route-node-height;
    border-radius: Theme.radius-sm;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: selected ? root.tint : Theme.border;
    animate border-color { duration: Theme.fast; }

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;
        Text {
            text: root.title;
            color: Theme.text;
            font-family: Theme.font-ui;
            font-size: Theme.text-sm;
            font-weight: Theme.weight-semibold;
            overflow: elide;
        }
        Text {
            text: root.meta;
            color: root.tint;
            font-family: Theme.font-mono;
            font-size: Theme.text-sm;
            overflow: elide;
        }
    }
}

// Arrow between nodes. It remains a neutral structural line; the selected node
// supplies the color signal.
component Arrow inherits Rectangle {
    in property <bool> live: false;
    height: 12px;
    horizontal-stretch: 1;

    Text {
        text: "\u{2192}";
        color: root.live ? Theme.primary : Theme.text-faint;
        font-family: Theme.font-ui;
        font-size: Theme.text-lg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A source in the narrow left rail.
component SourceItem inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    height: Theme.control-height - 4px;
    border-radius: Theme.radius-sm;
    background: active ? Theme.surface-3 : Theme.surface-4;
    animate background { duration: Theme.fast; }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        Text {
            text: root.text;
            color: Theme.text;
            font-family: Theme.font-ui;
            font-size: Theme.text-md;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MonitorPage inherits Rectangle {
    background: Theme.window-bg;
    clip: true;

    // Static route facts until the service exposes a graph snapshot.
    in-out property <int> source-index: 0;
    in-out property <float> source-level: -12.3;
    in-out property <float> gain-level: 6.0;
    in-out property <float> output-level: -6.5;

    property <[string]> sources: [
        "Line In · 1-2", "Microphone · 1", "Broadcast", "System Audio",
    ];
    property <bool> has-source: source-index >= 0 && source-index < sources.length;
    property <string> source-name: root.has-source ? sources[source-index] : "Source";

    HorizontalLayout {
        spacing: 0px;

        // Source rail.
        Rectangle {
            width: Theme.route-rail-width;
            background: Theme.surface;
            VerticalLayout {
                padding-top: Theme.space-4;
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                spacing: Theme.space-2;

                SectionLabel { text: "Sources"; }
                for source[i] in root.sources: SourceItem {
                    text: source;
                    active: i == root.source-index;
                    clicked => { root.source-index = i; }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        // Routing canvas.
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.window-bg;
            clip: true;
            VerticalLayout {
                padding: Theme.space-6;
                spacing: Theme.space-6;

                Text {
                    text: "Source → Process → Output";
                    color: Theme.text-muted;
                    font-family: Theme.font-ui;
                    font-size: Theme.text-lg;
                }

                HorizontalLayout {
                    // The reference keeps a wider gap after the first node,
                    // then centers the processor between source and output.
                    spacing: Theme.space-3;
                    RouteNode {
                        title: root.source-name;
                        meta: "\{root.source-level} dB";
                        tint: Theme.signal-device;
                        selected: true;
                    }
                    Arrow { live: true; }
                    Rectangle { min-width: Theme.space-7; }
                    RouteNode {
                        title: "Gain";
                        meta: "+\{root.gain-level} dB";
                        tint: Theme.primary;
                        selected: true;
                    }
                    Arrow { live: true; }
                    RouteNode {
                        title: "Main Out";
                        meta: "\{root.output-level} dB";
                        tint: Theme.signal-recorder;
                        selected: true;
                    }
                }

                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "48 kHz · 256 samples · Running";
                    color: Theme.text-muted;
                    font-family: Theme.font-ui;
                    font-size: Theme.text-sm;
                }
            }
        }
    }
}
