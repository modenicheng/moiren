// Monitor page — the simplified Figma routing canvas.
//
// The source rail uses stable service selections. The route canvas preserves
// the Figma composition while transport and diagnostics use real service state.

import { Theme } from "../theme.slint";
import { Backend } from "../backend.slint";
import { SectionLabel, AppSelect, AppButton, ButtonTone } from "../components.slint";

// Canvas node. The compact node geometry is deliberately smaller than the
// generic graph widget because this page previews one linear chain.
component RouteNode inherits Rectangle {
    in property <string> title;
    in property <string> meta;
    in property <color> tint: Theme.text-muted;
    in property <bool> selected: false;

    width: Theme.route-node-width;
    height: Theme.route-node-height;
    border-radius: Theme.radius-sm;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: selected ? root.tint : Theme.border;
    animate border-color { duration: Theme.fast; }

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;
        Text {
            text: root.title;
            color: Theme.text;
            font-family: Theme.font-ui;
            font-size: Theme.text-sm;
            font-weight: Theme.weight-semibold;
            overflow: elide;
        }
        Text {
            text: root.meta;
            color: root.tint;
            font-family: Theme.font-mono;
            font-size: Theme.text-sm;
            overflow: elide;
        }
    }
}

// Arrow between nodes. It remains a neutral structural line; the selected node
// supplies the color signal.
component Arrow inherits Rectangle {
    in property <bool> live: false;
    height: 12px;
    horizontal-stretch: 1;

    Text {
        text: "\u{2192}";
        color: root.live ? Theme.primary : Theme.text-faint;
        font-family: Theme.font-ui;
        font-size: Theme.text-lg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component MonitorPage inherits Rectangle {
    background: Theme.window-bg;
    clip: true;

    property <bool> has-source: Backend.source-mode == 0
        ? Backend.input-index >= 0 && Backend.input-index < Backend.inputs.length
        : Backend.process-index >= 0 && Backend.process-index < Backend.processes.length;
    property <string> source-name: !root.has-source ? "No Source"
        : Backend.source-mode == 0 ? Backend.inputs[Backend.input-index].name
        : Backend.processes[Backend.process-index].name;
    property <string> output-name: Backend.output-index >= 0 && Backend.output-index < Backend.outputs.length
        ? Backend.outputs[Backend.output-index].name : "No Output";

    HorizontalLayout {
        spacing: 0px;

        // Source rail.
        Rectangle {
            width: Theme.route-rail-width;
            background: Theme.surface;
            VerticalLayout {
                padding-top: Theme.space-4;
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                spacing: Theme.space-2;

                SectionLabel { text: "Sources"; }
                physical-mode := AppButton { text: "Input"; clicked => { Backend.source-mode = 0; } }
                process-mode := AppButton { text: "Process"; clicked => { Backend.source-mode = 1; } }
                input-selector := AppSelect {
                    visible: Backend.source-mode == 0;
                    options: Backend.input-options; current <=> Backend.input-index;
                    placeholder: "No Input"; selected(i) => { Backend.select-input(i); }
                }
                process-selector := AppSelect {
                    visible: Backend.source-mode == 1;
                    options: Backend.process-options; current <=> Backend.process-index;
                    placeholder: "No Process"; selected(i) => { Backend.select-process(i); }
                }
                SectionLabel { text: "Output"; }
                output-selector := AppSelect {
                    options: Backend.output-options; current <=> Backend.output-index;
                    placeholder: "No Output"; selected(i) => { Backend.select-output(i); }
                }
                start-monitor := AppButton {
                    text: "Start"; tone: ButtonTone.primary;
                    enabled: Backend.transport-ready && !Backend.active && Backend.monitor-valid;
                    clicked => { Backend.start-monitor(true, 0); }
                }
                stop-monitor := AppButton {
                    text: "Stop"; enabled: Backend.transport-ready && Backend.active;
                    clicked => { Backend.stop(); }
                }
                refresh-catalog := AppButton { text: "Refresh"; clicked => { Backend.refresh-catalog(); } }
                Rectangle { vertical-stretch: 1; }
            }
        }

        // Routing canvas.
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.window-bg;
            clip: true;
            VerticalLayout {
                padding: Theme.space-6;
                spacing: Theme.space-6;

                Text {
                    text: "Source → Process → Output";
                    color: Theme.text-muted;
                    font-family: Theme.font-ui;
                    font-size: Theme.text-lg;
                }

                HorizontalLayout {
                    // The reference keeps a wider gap after the first node,
                    // then centers the processor between source and output.
                    spacing: Theme.space-3;
                    RouteNode {
                        title: root.source-name;
                        meta: "— · NoData";
                        tint: Theme.signal-device;
                        selected: true;
                    }
                    Arrow { live: Backend.active; }
                    Rectangle { min-width: Theme.space-7; }
                    RouteNode {
                        title: "Gain";
                        meta: "Gain / Pan";
                        tint: Theme.primary;
                        selected: true;
                    }
                    Arrow { live: Backend.active; }
                    RouteNode {
                        title: root.output-name;
                        meta: "— · NoData";
                        tint: Theme.signal-recorder;
                        selected: true;
                    }
                }

                Rectangle { vertical-stretch: 1; }
                Text {
                    text: Backend.phase-text + " · " + Backend.elapsed;
                    color: Theme.text-muted;
                    font-family: Theme.font-ui;
                    font-size: Theme.text-sm;
                }
            }
        }
    }
}
