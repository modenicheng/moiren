// Node library panel — the left studio column. Adaptive behaviour:
//  * inline at Theme.library-width when the shell keeps it docked
//  * overlay flyout (same width) when the shell is narrow
// The panel itself never decides docking; the shell does.

import { Theme } from "../theme.slint";
import { Backend, LibraryEntry } from "../backend.slint";
import { TablerIcon } from "../components/tabler-icon.slint";
import { SectionHeading } from "../components/studio-controls.slint";
import { SessionSetup } from "session-setup.slint";

// Session-node row: icon, identity and source detail.
component LibraryItem inherits Rectangle {
    in property <bool> matching: true;
    in property <string> icon;
    in property <string> name;
    in property <string> subtitle;
    in property <string> detail;
    height: 54px;
    background: ta.has-hover ? Theme.surface-3 : transparent;
    animate background { duration: Theme.fast; }
    opacity: matching ? 1.0 : 0.35;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 0px;
        spacing: 6px;
        TablerIcon {
            name: root.icon;
            tint: Theme.text-muted;
            y: 10px;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.name;
                color: Theme.text;
                font-family: Theme.font-ui;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.subtitle;
                color: Theme.text-faint;
                font-family: Theme.font-ui;
                font-size: 9px;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.detail;
                color: Theme.text-faint;
                font-family: Theme.font-ui;
                font-size: 10px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Backend.select-library-node(root.name); }
    }
}

component LibraryCategory inherits VerticalLayout {
    vertical-stretch: 0;
    alignment: start;
    in property <string> title;
    in property <[LibraryEntry]> items;
    in property <string> filter;
    spacing: 0;
    property <string> f: filter.to-lowercase();
    property <bool> open: true;

    SectionHeading {
        title: root.title;
        open: root.open;
        toggle => { root.open = !root.open; }
    }
    if root.open: VerticalLayout {
        spacing: 0;
        for item in root.items: LibraryItem {
            icon: item.icon;
            name: item.name;
            subtitle: item.subtitle;
            detail: item.detail;
            matching: root.f == ""
                || item.name.to-lowercase().starts-with(root.f)
                || item.subtitle.to-lowercase().starts-with(root.f)
                || item.detail.to-lowercase().starts-with(root.f);
        }
    }
}

export component NodeLibrary inherits Rectangle {
    in-out property <string> filter;
    background: Theme.surface-2;
    border-color: Theme.border;
    border-width: 1px;

    library-scope := FocusScope {
        x: 0; y: 0; width: 100%; height: 100%;

        VerticalLayout {
            padding: Theme.space-3;
            spacing: Theme.space-2;

            // Heading.
            HorizontalLayout {
                spacing: Theme.space-2;
                height: 24px;
                Text {
                    text: "Session & nodes";
                    color: Theme.text;
                    font-family: Theme.font-ui;
                    font-size: 13px;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Image {
                    source: @image-url("../icons/chevron.svg");
                    colorize: Theme.text-faint;
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                }
            }

            // Search field (32px, Ctrl K).
            Rectangle {
                height: 32px;
                border-radius: 4px;
                background: Theme.surface;
                border-width: 1px;
                border-color: search.has-focus ? Theme.primary : Theme.border;
                animate border-color { duration: Theme.fast; }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    TablerIcon {
                        name: "search";
                        tint: Theme.text-faint;
                        width: 14px;
                        height: 14px;
                        y: (parent.height - self.height) / 2;
                    }
                    search := TextInput {
                        text <=> root.filter;
                        color: Theme.text;
                        font-family: Theme.font-ui;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.filter == "": Text {
                        text: "Ctrl K";
                        color: Theme.text-faint;
                        font-family: Theme.font-ui;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
                TouchArea { clicked => { search.focus(); } }
            }

            // Categories scroll when the panel is short.
            Flickable {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: 0;
                    SessionSetup { }
                    LibraryCategory {
                        title: "SOURCES";
                        items: Backend.library-sources;
                        filter: root.filter;
                    }
                    LibraryCategory {
                        title: "PROCESSING";
                        items: Backend.library-processing;
                        filter: root.filter;
                    }
                    LibraryCategory {
                        title: "DESTINATIONS";
                        items: Backend.library-destinations;
                        filter: root.filter;
                    }
                }
            }

            // Drag hint card.
            Rectangle {
                vertical-stretch: 0;
                height: 67px;
                border-radius: 4px;
                background: Theme.surface;
                VerticalLayout {
                    padding: 10px;
                    spacing: 5px;
                    Text {
                        text: "Select a session node";
                        color: Theme.text-muted;
                        font-family: Theme.font-ui;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Click a library item to locate it. Drag cards to arrange the graph.";
                        color: Theme.text-faint;
                        font-family: Theme.font-ui;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
