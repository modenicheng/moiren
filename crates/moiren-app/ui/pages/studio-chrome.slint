// Studio chrome from the v0.1.2 App Toolbar component.
// Matrix and Devices are visible but unavailable until their backend pages exist.

import { Theme } from "../theme.slint";
import { Backend } from "../backend.slint";
import {
    DevReadyIconButton,
    DevReadyProjectSelector,
    DevReadyEngineStatus,
    DevReadyWindowButton,
} from "../components/dev-ready.slint";
import { TablerIcon } from "../components/tabler-icon.slint";

component WorkspaceTab inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    width: Theme.compact ? 83px : 112px;
    height: Theme.toolbar-height;
    opacity: root.enabled ? 1 : 0.42;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 4px;
        background: tab.has-hover && root.enabled ? Theme.dev-control : transparent;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            alignment: center;

            if !Theme.compact: TablerIcon {
                name: root.icon;
                tint: root.active ? Theme.primary : Theme.dev-text-secondary;
            }
            Text {
                text: root.label;
                color: root.active ? Theme.primary : Theme.dev-text-secondary;
                font-family: Theme.font-ui;
                font-size: 12px;
                font-weight: Theme.weight-medium;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.active: Rectangle {
            x: 0px;
            y: parent.height - 2px;
            width: parent.width;
            height: 2px;
            background: Theme.primary;
        }
    }

    tab := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppToolbar inherits Rectangle {
    in-out property <int> view: 0;
    callback view-changed(int);
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    height: Theme.toolbar-height;
    background: Theme.dev-bar;
    border-width: 0px;
    border-color: Theme.dev-border;

    WindowMoveArea {
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 0px;
            alignment: space-between;

            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: Theme.compact ? 4px : 8px;

                Rectangle {
                    width: 28px;
                    height: 36px;
                    horizontal-stretch: 0;
                    Image {
                        source: @image-url("../../../../assets/logos/moiren-2c-mark-light.svg");
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                DevReadyProjectSelector {
                    compact: Theme.compact;
                    project-name: Theme.compact ? "Main Session" : "Moiren Studio - Main Session";
                }

                Rectangle {
                    width: 1px;
                    height: 24px;
                    background: Theme.dev-border;
                    horizontal-stretch: 0;
                }
            }

            HorizontalLayout {
                width: Theme.compact ? 332px : 448px;
                horizontal-stretch: 0;
                spacing: 0px;

                WorkspaceTab {
                    label: "Graph";
                    icon: "route";
                    active: root.view == 0;
                    clicked => { root.view = 0; root.view-changed(0); }
                }
                WorkspaceTab {
                    label: "Mixer";
                    icon: "wave";
                    active: root.view == 1;
                    clicked => { root.view = 1; root.view-changed(1); }
                }
                WorkspaceTab {
                    label: "Matrix";
                    icon: "grid";
                    enabled: false;
                }
                WorkspaceTab {
                    label: "Devices";
                    icon: "devices";
                    enabled: false;
                }
            }

            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: Theme.compact ? 4px : 8px;

                if !Theme.compact: DevReadyEngineStatus {
                    label: Backend.active ? "Running" : "Idle";
                    running: Backend.active;
                }

                DevReadyIconButton {
                    icon: "settings";
                    enabled: false;
                }

                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 0px;
                    DevReadyWindowButton {
                        icon: "minimize";
                        clicked => { root.minimize(); }
                    }
                    DevReadyWindowButton {
                        icon: "maximize";
                        clicked => { root.toggle-maximize(); }
                    }
                    DevReadyWindowButton {
                        icon: "close";
                        danger: true;
                        clicked => { root.close-window(); }
                    }
                }
            }
        }
    }
}

export component EngineStatusbar inherits Rectangle {
    height: Theme.statusbar-height;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 23px;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Backend.active ? Theme.primary : Theme.text-faint;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: Backend.phase-text;
                color: Backend.active ? Theme.primary : Theme.text-faint;
                font-family: Theme.font-mono;
                font-size: 10px;
                vertical-alignment: center;
            }
            if !Theme.compact: Text {
                text: Backend.engine-format;
                color: Theme.text-muted;
                font-family: Theme.font-mono;
                font-size: 10px;
                vertical-alignment: center;
            }
            if !Theme.compact: Text {
                text: Backend.engine-latency;
                color: Theme.text-muted;
                font-family: Theme.font-mono;
                font-size: 10px;
                vertical-alignment: center;
            }
            if Theme.viewport-width >= 1500px: Text {
                text: "Clock: " + Backend.engine-clock;
                color: Theme.text-muted;
                font-family: Theme.font-mono;
                font-size: 10px;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 11px;
            HorizontalLayout {
                spacing: 24px;
                Text { text: "CPU " + Backend.engine-cpu; color: Theme.text-muted; font-family: Theme.font-mono; font-size: 10px; vertical-alignment: center; }
                Text { text: "XRUN " + Backend.engine-xrun; color: Theme.text-muted; font-family: Theme.font-mono; font-size: 10px; vertical-alignment: center; }
            }
            Rectangle { width: 1px; height: 15px; background: Theme.grip; y: (parent.height - self.height) / 2; }
            Text { text: "v0.1.0"; color: Theme.primary; font-family: Theme.font-mono; font-size: 10px; vertical-alignment: center; }
        }
    }
}
