// Settings page — four reference blocks in a two-column grid.
//
// The full-screen layout maps directly to the design: theme/audio on the left
// and application/about on the right. At windowed width the same grid folds to
// a single column so nothing depends on absolute geometry.

import { Theme, ThemePreference } from "../theme.slint";
import {
    AppButton, Badge, ButtonTone, Card, KeyValue, PageHeader, SectionLabel,
} from "../components.slint";

// A neutral choice control styled like the design's rectangular action tiles.
// Dark is intentionally filled with the primary accent; the others are neutral.
component ChoiceTile inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    height: Theme.control-height;
    horizontal-stretch: 1;
    border-radius: Theme.radius-md;
    background: active ? Theme.primary : Theme.surface-4;
    border-width: active ? 0px : 1px;
    border-color: Theme.border;
    animate background { duration: Theme.fast; }

    Text {
        text: root.text;
        color: root.active ? Theme.on-primary : Theme.text;
        font-family: Theme.font-ui;
        font-size: Theme.text-md;
        font-weight: Theme.weight-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The design's read-only choice field: fixed placeholder text on a control
// surface. It communicates the current preference without implying an
// unimplemented dropdown is clickable.
component SettingValue inherits Rectangle {
    in property <string> text;
    width: Theme.settings-control-width;
    height: Theme.control-height;
    border-radius: Theme.radius-sm;
    background: Theme.surface-4;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        Text {
            text: root.text;
            color: Theme.text;
            font-family: Theme.font-ui;
            font-size: Theme.text-md;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

// Label/value row with the value column fixed, matching the reference columns.
component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    spacing: Theme.space-4;
    Text {
        text: root.label;
        color: Theme.text;
        font-family: Theme.font-ui;
        font-size: Theme.text-md;
        vertical-alignment: center;
    }
    Rectangle { horizontal-stretch: 1; }
    SettingValue {
        text: root.value;
        y: (parent.height - self.height) / 2;
    }
}

export component SettingsPage inherits VerticalLayout {
    callback exit-app();
    spacing: Theme.settings-card-gap;
    vertical-stretch: 1;

    // Session-local placeholders. The Rust service does not own these
    // preferences yet, so they deliberately stay in the page.
    in-out property <int> theme-choice: 2;
    in-out property <bool> show-grid: true;
    in-out property <bool> auto-save: true;

    PageHeader {
        title: "Settings";
        subtitle: "Appearance, audio preferences and application information.";
    }

    GridLayout {
        spacing: Theme.settings-card-gap;

        Row {
            Card {
                max-width: Theme.settings-column-max;
                VerticalLayout {
                    padding: Theme.space-6;
                    spacing: Theme.space-6;

                    SectionLabel { text: "Theme"; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: Theme.space-5;
                        ChoiceTile {
                            text: "Dark";
                            active: root.theme-choice == 0;
                            clicked => {
                                root.theme-choice = 0;
                                Theme.preference = ThemePreference.dark;
                            }
                        }
                        ChoiceTile {
                            text: "Light";
                            active: root.theme-choice == 1;
                            clicked => {
                                root.theme-choice = 1;
                                Theme.preference = ThemePreference.light;
                            }
                        }
                        ChoiceTile {
                            text: "Auto";
                            active: root.theme-choice == 2;
                            clicked => {
                                root.theme-choice = 2;
                                Theme.preference = ThemePreference.system;
                            }
                        }
                    }
                }
            }
            Card {
                VerticalLayout {
                    padding: Theme.space-6;
                    spacing: Theme.space-4;

                    SectionLabel { text: "Application"; }
                    Rectangle { vertical-stretch: 1; }
                    SettingRow { label: "Show Grid"; value: root.show-grid ? "On" : "Off"; }
                    SettingRow { label: "Auto-save Project"; value: root.auto-save ? "On" : "Off"; }
                    SettingRow { label: "Level Meter Scale"; value: "dBFS"; }
                }
            }
        }
        Row {
            Card {
                max-width: Theme.settings-column-max;
                VerticalLayout {
                    padding: Theme.space-6;
                    spacing: Theme.space-4;

                    SectionLabel { text: "Audio Preferences"; }
                    Rectangle { vertical-stretch: 1; }
                    SettingRow { label: "Sample Rate"; value: "48000 Hz"; }
                    SettingRow { label: "Buffer Size"; value: "256 samples"; }
                    SettingRow { label: "Bit Depth"; value: "24-bit"; }
                    SettingRow { label: "Auto-start Engine"; value: "Enabled"; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            Card {
                VerticalLayout {
                    padding: Theme.space-6;
                    spacing: Theme.space-4;

                    SectionLabel { text: "About"; }
                    Text {
                        text: "Moiren";
                        color: Theme.primary;
                        font-family: Theme.font-ui;
                        font-size: Theme.text-2xl;
                        font-weight: Theme.weight-semibold;
                    }
                    Text {
                        text: "Version 0.1.0";
                        color: Theme.text;
                        font-family: Theme.font-ui;
                        font-size: Theme.text-md;
                    }
                    Text {
                        text: "Real-time audio processing workstation\nBuilt with Rust and Slint";
                        color: Theme.text-muted;
                        font-family: Theme.font-ui;
                        font-size: Theme.text-md;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                    AppButton {
                        text: "Quit Moiren";
                        tone: ButtonTone.danger;
                        horizontal-stretch: 0;
                        clicked => { root.exit-app(); }
                    }
                }
            }
        }
    }
}
