// Components marked RUNTIME-READY in Moiren-UI-v0.1.2.
// Audio graph-specific components intentionally remain in their existing
// files and are not part of this library.

import { Theme } from "../theme.slint";
import { TablerIcon } from "tabler-icon.slint";

export enum DevReadyButtonTone { secondary, ghost, danger }
export enum DevReadyBadgeTone { info, active, pending, warning, danger, unavailable, prototype }

export component DevReadyButton inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <DevReadyButtonTone> tone: DevReadyButtonTone.secondary;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <bool> focused: false;
    in property <length> control-height: 32px;
    callback clicked();

    height: root.control-height;
    horizontal-stretch: 0;
    border-radius: 4px;
    border-width: root.focused || root.selected ? 2px : 1px;
    border-color: root.focused || root.selected ? Theme.primary : root.tone == DevReadyButtonTone.danger ? Theme.dev-coral : Theme.dev-border;
    background: !root.enabled ? Theme.dev-input
        : root.tone == DevReadyButtonTone.danger ? (button.has-hover ? Theme.dev-coral : Theme.dev-input)
        : root.tone == DevReadyButtonTone.ghost ? (button.has-hover ? Theme.dev-control : transparent)
        : (button.pressed ? Theme.dev-control : button.has-hover ? Theme.dev-control : Theme.dev-input);
    opacity: root.enabled ? 1 : 0.45;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": TablerIcon {
            name: root.icon;
            tint: root.tone == DevReadyButtonTone.danger && button.has-hover ? #ffffff
                : root.selected || root.focused ? Theme.primary : Theme.dev-text-secondary;
            width: 16px;
            height: 16px;
        }
        Text {
            text: root.text;
            color: root.tone == DevReadyButtonTone.danger && button.has-hover ? #ffffff
                : root.selected || root.focused ? Theme.primary : Theme.dev-text-secondary;
            font-family: Theme.font-ui;
            font-size: 12px;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
        }
    }

    button := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DevReadyIconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 4px;
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.primary : Theme.dev-border;
    background: action.pressed || action.has-hover ? Theme.dev-control : transparent;
    opacity: enabled ? 1 : 0.45;
    TablerIcon {
        name: root.icon;
        tint: root.selected ? Theme.primary : Theme.dev-text-secondary;
        width: 16px;
        height: 16px;
    }
    action := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DevReadyWindowButton inherits Rectangle {
    in property <string> icon;
    in property <bool> danger: false;
    callback clicked();
    width: 46px;
    height: 32px;
    background: action.has-hover ? (root.danger ? Theme.dev-coral : Theme.dev-control) : transparent;
    Image {
        source: root.icon == "minimize" ? @image-url("../icons/win-min.svg")
            : root.icon == "maximize" ? @image-url("../icons/win-max.svg")
            : @image-url("../icons/win-close.svg");
        colorize: action.has-hover && root.danger ? #ffffff : Theme.dev-text-secondary;
        width: 16px;
        height: 16px;
    }
    action := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DevReadyStatusBadge inherits Rectangle {
    in property <string> text: "Info";
    in property <DevReadyBadgeTone> tone: DevReadyBadgeTone.info;
    in property <bool> compact: false;
    height: compact ? 18px : 22px;
    width: compact ? 86px : 112px;
    border-radius: self.height / 2;
    border-width: 1px;
    property <color> accent: tone == DevReadyBadgeTone.info ? Theme.signal-device
        : tone == DevReadyBadgeTone.active ? Theme.dev-cyan
        : tone == DevReadyBadgeTone.pending || tone == DevReadyBadgeTone.warning ? Theme.dev-gold
        : tone == DevReadyBadgeTone.danger ? Theme.dev-coral
        : tone == DevReadyBadgeTone.prototype ? Theme.dev-purple
        : Theme.dev-text-tertiary;
    border-color: accent;
    background: accent.with-alpha(0.06);
    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Text {
            text: tone == DevReadyBadgeTone.active ? "✓" : tone == DevReadyBadgeTone.warning ? "△" : tone == DevReadyBadgeTone.unavailable ? "···" : "ⓘ";
            color: root.accent;
            font-family: Theme.font-mono;
            font-size: 10px;
        }
        Text {
            text: root.text;
            color: root.accent;
            font-family: Theme.font-ui;
            font-size: 10px;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
        }
    }
}

export component DevReadyProjectSelector inherits Rectangle {
    in property <string> project-name: "Untitled Project";
    in property <bool> dirty: true;
    in property <bool> open: false;
    in property <bool> compact: false;
    callback clicked();
    width: compact ? 158px : 244px;
    height: 36px;
    border-radius: 4px;
    border-width: open ? 2px : 1px;
    border-color: open ? Theme.primary : Theme.dev-border;
    background: selector.has-hover ? Theme.dev-control : Theme.dev-input;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        TablerIcon { name: "folder-open"; tint: Theme.dev-text-secondary; width: 16px; height: 16px; }
        Text {
            text: root.project-name;
            color: Theme.dev-text-primary;
            font-family: Theme.font-ui;
            font-size: 11px;
            font-weight: Theme.weight-medium;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        if root.dirty: Rectangle { width: 4px; height: 4px; border-radius: 2px; background: Theme.primary; }
        Image { source: @image-url("../icons/chevron.svg"); colorize: Theme.dev-text-secondary; width: 14px; height: 14px; }
    }
    selector := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component DevReadyEngineStatus inherits Rectangle {
    in property <string> label: "Idle";
    in property <bool> running: false;
    width: 118px;
    height: 28px;
    border-radius: 999px;
    border-width: 1px;
    border-color: Theme.dev-border;
    background: Theme.dev-input;
    HorizontalLayout {
        alignment: center;
        spacing: 7px;
        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.running ? Theme.dev-mint : Theme.dev-text-tertiary; }
        Text { text: root.label; color: Theme.dev-text-secondary; font-family: Theme.font-ui; font-size: 10px; font-weight: Theme.weight-medium; }
    }
}

export component DevReadySearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "Search nodes and devices";
    in property <bool> enabled: true;
    width: 186px;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: field.has-focus ? Theme.primary : Theme.dev-border;
    background: field.has-focus ? Theme.dev-control : Theme.dev-input;
    opacity: enabled ? 1 : 0.45;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        TablerIcon { name: "search"; tint: Theme.dev-text-secondary; width: 16px; height: 16px; }
        search-input := Rectangle {
            horizontal-stretch: 1;
            background: transparent;
            field := TextInput { text <=> root.text; color: Theme.dev-text-primary; font-family: Theme.font-ui; font-size: 11px; width: parent.width; height: parent.height; vertical-alignment: center; }
            if root.text == "" && !field.has-focus: Text {
                text: root.placeholder;
                color: Theme.dev-text-tertiary;
                font-family: Theme.font-ui;
                font-size: 11px;
                width: parent.width;
                height: parent.height;
                vertical-alignment: center;
            }
        }
        if root.text != "": Text { text: "×"; color: Theme.dev-text-secondary; font-size: 16px; }
    }
}

export component DevReadyToggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 42px;
    height: 20px;
    border-radius: 10px;
    background: checked ? Theme.primary : Theme.dev-input;
    border-width: 1px;
    border-color: checked ? Theme.primary : Theme.dev-border;
    opacity: enabled ? 1 : 0.45;
    Rectangle { width: 14px; height: 14px; y: 2px; x: root.checked ? 25px : 3px; border-radius: 7px; background: #f6f8fa; }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
}

export component DevReadyNumericField inherits Rectangle {
    in-out property <string> value: "-12.0 dB";
    in property <bool> focused: false;
    in property <bool> error: false;
    in property <bool> enabled: true;
    callback increment();
    callback decrement();
    width: 156px;
    height: 32px;
    border-radius: 4px;
    border-width: focused ? 2px : 1px;
    border-color: error ? Theme.dev-coral : focused ? Theme.primary : Theme.dev-border;
    background: Theme.dev-input;
    opacity: enabled ? 1 : 0.45;
    Text { text: root.value; color: Theme.dev-text-primary; font-family: Theme.font-mono; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
    VerticalLayout { width: 22px; x: parent.width - self.width; Rectangle { height: 16px; Text { text: "+"; color: Theme.dev-text-secondary; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.increment(); } } } Rectangle { height: 16px; Text { text: "−"; color: Theme.dev-text-secondary; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.decrement(); } } } } 
}

export component DevReadyKnob inherits Rectangle {
    in property <string> label: "Gain";
    in property <string> value: "-6.0 dB";
    in property <float> progress: 0.65;
    in property <bool> focused: false;
    width: 100px;
    height: 112px;
    border-width: focused ? 2px : 0px;
    border-color: Theme.primary;
    Text { text: root.label; color: Theme.dev-text-secondary; font-family: Theme.font-ui; font-size: 10px; horizontal-alignment: center; y: 4px; width: parent.width; }
    Rectangle { x: (parent.width - 42px) / 2; y: 25px; width: 42px; height: 42px; border-radius: 21px; background: Theme.dev-input; border-width: 3px; border-color: Theme.dev-border; Rectangle { x: 0px; y: 0px; width: 42px; height: 42px; border-radius: 21px; border-width: 3px; border-color: Theme.primary; transform-rotation: -135deg + root.progress * 270deg; } Rectangle { x: 19px; y: 4px; width: 4px; height: 14px; border-radius: 2px; background: Theme.dev-text-primary; transform-rotation: -135deg + root.progress * 270deg; transform-origin: {x: 2px, y: 17px}; } } 
    Text { text: root.value; color: Theme.dev-text-primary; font-family: Theme.font-mono; font-size: 9px; horizontal-alignment: center; y: 76px; width: parent.width; }
}
