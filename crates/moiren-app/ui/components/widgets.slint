// Moiren reusable building blocks.
//
// These are hand-built rather than `std-widgets` widgets on purpose: the
// design language is a dense instrument panel (hairline borders, wide-tracked
// micro labels, monospaced read-outs, LED-ladder meters) that the platform
// widgets cannot express. Nothing here hard-codes a colour — every value comes
// from `Theme`, so switching scheme or size class restyles the whole app.
//
// Components never read `Backend`; pages own that wiring and pass plain values
// down, which keeps every block previewable on its own.

import { Theme } from "theme.slint";

// ---------------------------------------------------------------------------
// Surfaces & labels
// ---------------------------------------------------------------------------

export component Card inherits Rectangle {
    in property <bool> raised: false;
    in property <bool> flat: false;
    background: Theme.surface-2;
    border-radius: Theme.radius-lg;
    border-width: flat ? 0px : 1px;
    border-color: Theme.border;
    drop-shadow-color: raised ? Theme.shadow : transparent;
    drop-shadow-blur: Theme.shadow-blur;
    drop-shadow-offset-y: 8px;
    @children
}

// Small-caps style micro label that heads a block ("信号来源", "OUTPUT").
export component SectionLabel inherits Text {
    color: Theme.text-faint;
    font-family: Theme.font-ui;
    font-size: Theme.text-xs;
    font-weight: Theme.weight-semibold;
    letter-spacing: Theme.tracking-label;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.hairline;
}

// ---------------------------------------------------------------------------
// Badge
// ---------------------------------------------------------------------------

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.text-muted;
    in property <color> bg: Theme.surface-3;
    in property <bool> dot: false;
    in property <color> dot-color: fg;
    in property <bool> outline: false;

    // Hug the text: a badge must never stretch to the layout width.
    horizontal-stretch: 0;
    height: 22px;
    border-radius: Theme.radius-pill;
    background: bg;
    border-width: outline ? 1px : 0px;
    border-color: Theme.border-strong;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        alignment: center;
        if root.dot: Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.dot-color;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.fg;
            font-family: Theme.font-ui;
            font-size: Theme.text-xs;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }
}

// A monospaced numeric pill, e.g. "−12.3 dBFS" or "440 Hz".
export component ValuePill inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.text;
    in property <bool> strong: false;
    horizontal-stretch: 0;
    height: 22px;
    border-radius: Theme.radius-sm;
    background: strong ? Theme.surface-4 : Theme.surface-3;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.text;
            color: root.fg;
            font-family: Theme.font-mono;
            font-size: Theme.text-xs;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }
}

// ---------------------------------------------------------------------------
// Buttons
// ---------------------------------------------------------------------------

// Filled tones carry the accent; outlined tones are neutral or semantical.
// `record` replaces a red "stop": in this palette transport gold *is* the
// recording/transport colour, and it keeps red out of the accent set.
export enum ButtonTone { primary, neutral, record, danger }

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <ButtonTone> tone: ButtonTone.neutral;
    in property <bool> enabled: true;
    callback clicked();

    horizontal-stretch: 0;
    height: Theme.control-height;
    min-width: content.min-width + 2 * Theme.space-4;
    border-radius: Theme.radius-md;
    opacity: enabled ? 1.0 : 0.4;

    property <color> accent:
        tone == ButtonTone.primary ? Theme.primary
        : tone == ButtonTone.record ? Theme.signal-recorder
        : tone == ButtonTone.danger ? Theme.danger
        : Theme.text-muted;
    property <bool> filled: tone == ButtonTone.primary || tone == ButtonTone.record;
    property <color> ink: filled ? Theme.on-primary : (tone == ButtonTone.danger ? Theme.danger : Theme.text);

    border-width: filled ? 0px : 1px;
    border-color: tone == ButtonTone.danger ? Theme.danger.with-alpha(0.45) : Theme.border-strong;
    background: filled
        ? (ta.pressed ? self.accent.darker(0.16) : ta.has-hover ? self.accent.brighter(0.08) : self.accent)
        : (ta.pressed ? Theme.surface-4 : ta.has-hover ? Theme.surface-3 : Theme.surface-2);
    animate background { duration: Theme.fast; }

    content := HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-2;
        alignment: center;
        if root.icon.width > 0: Image {
            source: root.icon;
            colorize: root.ink;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.ink;
            font-family: Theme.font-ui;
            font-size: Theme.text-md;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.text-muted;
    in property <color> hover-bg: Theme.surface-3;
    in property <length> size: Theme.control-height;
    in property <bool> enabled: true;
    callback clicked();

    horizontal-stretch: 0;
    width: size;
    height: size;
    border-radius: Theme.radius-sm;
    opacity: enabled ? 1.0 : 0.4;
    background: ta.pressed ? hover-bg.darker(0.12) : ta.has-hover ? hover-bg : transparent;
    animate background { duration: Theme.fast; }

    Image {
        source: root.icon;
        colorize: ta.has-hover ? Theme.text : root.tint;
        width: root.size * 0.48;
        height: root.size * 0.48;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---------------------------------------------------------------------------
// Toggle
// ---------------------------------------------------------------------------

export component AppToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 42px;
    height: 24px;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    opacity: enabled ? 1.0 : 0.45;
    background: checked ? Theme.primary : Theme.surface-4;
    animate background { duration: Theme.fast; }

    Rectangle {
        width: 18px;
        height: 18px;
        border-radius: self.width / 2;
        y: (parent.height - self.height) / 2;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        background: root.checked ? Theme.on-primary : Theme.text-muted;
        animate x, background { duration: Theme.fast; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// ---------------------------------------------------------------------------
// Slider
// ---------------------------------------------------------------------------

export component AppSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value: 0.5;
    in property <bool> bipolar: false;   // fill grows out from the centre (pan)
    in property <bool> enabled: true;
    in property <int> ticks: 0;          // >0 draws a tick ruler under the track
    in property <brush> accent: Theme.brand-gradient;
    callback changed(float);

    height: self.ticks > 0 ? 26px : 22px;
    horizontal-stretch: 1;
    opacity: enabled ? 1.0 : 0.45;

    property <length> track-h: 6px;
    property <length> knob: 14px;
    property <float> frac: ((value - minimum) / max(0.0001, maximum - minimum)).clamp(0, 1);
    property <length> usable: max(1px, self.width - self.knob);

    // Track well: inset, so the filled portion reads as "signal level".
    Rectangle {
        y: (parent.height - root.track-h) / 2;
        x: root.knob / 2;
        width: parent.width - root.knob;
        height: root.track-h;
        border-radius: self.height / 2;
        background: Theme.surface-3;
        border-width: 1px;
        border-color: Theme.hairline;
        clip: true;

        // Filled portion. Bipolar grows from the centre in both directions.
        Rectangle {
            y: 0;
            height: 100%;
            border-radius: parent.height / 2;
            background: root.accent;
            x: root.bipolar ? parent.width * min(root.frac, 0.5) : 0;
            width: root.bipolar ? parent.width * abs(root.frac - 0.5)
                : parent.width * root.frac;
        }
    }

    // Centre detent marker for bipolar controls.
    if root.bipolar: Rectangle {
        x: parent.width / 2;
        width: 1px;
        height: 10px;
        y: (parent.height - self.height) / 2;
        background: Theme.text-faint.with-alpha(0.55);
    }

    // Tick ruler: nine marks, enough to read a step without becoming a scale.
    for i in 9: Rectangle {
        visible: root.ticks > 0;
        x: root.knob / 2 + (root.width - root.knob) * (i / 8.0) - 0.5px;
        width: 1px;
        height: 4px;
        y: root.height - self.height;
        background: Theme.text-faint.with-alpha(0.35);
    }

    Rectangle {
        width: root.knob;
        height: root.knob;
        border-radius: self.width / 2;
        y: (parent.height - self.height) / 2;
        x: root.frac * root.usable;
        background: Theme.dark ? #e9eef1 : #ffffff;
        border-width: 2px;
        border-color: Theme.primary;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 1px;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        property <float> f: ((self.mouse-x - root.knob / 2) / max(1px, root.usable)).clamp(0, 1);
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.value = root.minimum + self.f * (root.maximum - root.minimum);
                root.changed(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                root.value = root.minimum + self.f * (root.maximum - root.minimum);
                root.changed(root.value);
            }
        }
    }
}

// One labelled slider: title on the left, monospaced read-out on the right,
// track underneath.
export component ControlRow inherits VerticalLayout {
    in property <string> title;
    in property <string> readout;
    in property <image> icon;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <bool> bipolar: false;
    in property <bool> enabled: true;
    in property <int> ticks: 0;
    in property <string> hint;
    in-out property <float> value;
    callback changed(float);
    spacing: Theme.space-2;

    HorizontalLayout {
        spacing: Theme.space-2;
        if root.icon.width > 0: Image {
            source: root.icon;
            colorize: Theme.text-faint;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.title;
            color: Theme.text-muted;
            font-family: Theme.font-ui;
            font-size: Theme.text-sm;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        ValuePill { text: root.readout; }
    }
    AppSlider {
        minimum: root.minimum;
        maximum: root.maximum;
        bipolar: root.bipolar;
        enabled: root.enabled;
        ticks: root.ticks;
        value <=> root.value;
        changed(v) => { root.changed(v); }
    }
    if root.hint != "": Text {
        text: root.hint;
        color: Theme.text-faint;
        font-size: Theme.text-xs;
    }
}

// ---------------------------------------------------------------------------
// Select
// ---------------------------------------------------------------------------

export struct SelectOption {
    text: string,
    detail: string,
}

export component AppSelect inherits Rectangle {
    in property <[SelectOption]> options;
    in property <image> icon;
    in property <string> placeholder: "选择…";
    in property <bool> enabled: true;
    in-out property <int> current: 0;
    callback selected(int);

    height: Theme.control-height + 12px;
    horizontal-stretch: 1;
    opacity: enabled ? 1.0 : 0.5;
    border-radius: Theme.radius-md;
    background: ta.has-hover ? Theme.surface-3 : Theme.surface-4;
    border-width: 1px;
    border-color: popup-open ? Theme.primary : Theme.border;
    animate border-color, background { duration: Theme.fast; }

    property <bool> popup-open: false;
    property <bool> has-value: current >= 0 && current < options.length;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;

        if root.icon.width > 0: Rectangle {
            width: 30px;
            height: 30px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: Theme.primary-soft;
            Image {
                source: root.icon;
                colorize: Theme.primary;
                width: 17px;
                height: 17px;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.has-value ? root.options[root.current].text : root.placeholder;
                color: root.has-value ? Theme.text : Theme.text-faint;
                font-family: Theme.font-ui;
                font-size: Theme.text-md;
                font-weight: Theme.weight-semibold;
                overflow: elide;
            }
            if root.has-value && root.options[root.current].detail != "": Text {
                text: root.options[root.current].detail;
                color: Theme.text-muted;
                font-size: Theme.text-xs;
                overflow: elide;
            }
        }

        Image {
            source: @image-url("icons/chevron.svg");
            colorize: Theme.text-muted;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            transform-rotation: root.popup-open ? 180deg : 0deg;
            animate transform-rotation { duration: Theme.fast; }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { popup.show(); root.popup-open = true; }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: root.width;
        height: min(320px, root.options.length * 48px + 2 * Theme.space-2);
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.surface-2;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.shadow-blur;
            drop-shadow-offset-y: 10px;

            Flickable {
                VerticalLayout {
                    padding: Theme.space-2;
                    spacing: 2px;
                    for opt[i] in root.options: Rectangle {
                        height: 44px;
                        border-radius: Theme.radius-sm;
                        background: i == root.current ? Theme.primary-soft
                            : row-ta.has-hover ? Theme.surface-3 : transparent;
                        HorizontalLayout {
                            padding-left: Theme.space-3;
                            padding-right: Theme.space-3;
                            spacing: Theme.space-2;
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: opt.text;
                                    color: i == root.current ? Theme.primary : Theme.text;
                                    font-size: Theme.text-sm;
                                    font-weight: Theme.weight-semibold;
                                    overflow: elide;
                                }
                                if opt.detail != "": Text {
                                    text: opt.detail;
                                    color: Theme.text-muted;
                                    font-size: Theme.text-xs;
                                    overflow: elide;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if i == root.current: Image {
                                source: @image-url("icons/check.svg");
                                colorize: Theme.primary;
                                width: 15px;
                                height: 15px;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.current = i;
                                root.selected(i);
                                root.popup-open = false;
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Segmented switch (two mutually exclusive choices)
// ---------------------------------------------------------------------------

export component Segmented inherits Rectangle {
    in property <string> label-a;
    in property <string> label-b;
    in property <image> icon-a;
    in property <image> icon-b;
    in-out property <int> current: 0;
    callback changed(int);

    height: Theme.control-height + 4px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-md;
    background: Theme.surface-3;
    border-width: 1px;
    border-color: Theme.hairline;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for seg[i] in [
            { t: root.label-a, ic: root.icon-a },
            { t: root.label-b, ic: root.icon-b },
        ]: Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.radius-sm;
            background: i == root.current ? Theme.surface-2 : transparent;
            drop-shadow-color: i == root.current ? Theme.shadow : transparent;
            drop-shadow-blur: Theme.shadow-blur-sm;
            drop-shadow-offset-y: 2px;
            animate background { duration: Theme.fast; }
            HorizontalLayout {
                alignment: center;
                spacing: Theme.space-2;
                Image {
                    source: seg.ic;
                    colorize: i == root.current ? Theme.primary : Theme.text-faint;
                    width: 15px;
                    height: 15px;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: seg.t;
                    color: i == root.current ? Theme.text : Theme.text-muted;
                    font-family: Theme.font-ui;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.current = i; root.changed(i); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Level meters
// ---------------------------------------------------------------------------

component MeterChannel inherits Rectangle {
    in property <string> label;
    in property <float> level;    // 0..1
    in property <float> peak;     // 0..1
    in property <bool> available: false;
    height: 18px;

    HorizontalLayout {
        spacing: Theme.space-2;
        Text {
            text: root.label;
            color: Theme.text-faint;
            font-family: Theme.font-mono;
            font-size: Theme.text-xs;
            font-weight: Theme.weight-semibold;
            width: 10px;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 3px;
            background: Theme.surface-3;
            border-width: 1px;
            border-color: Theme.hairline;
            clip: true;

            // Level fill with the blue -> violet -> gold ramp.
            Rectangle {
                x: 0;
                height: 100%;
                width: parent.width * root.level.clamp(0, 1);
                background: @linear-gradient(90deg,
                    Theme.meter-low 0%,
                    Theme.meter-low 60%,
                    Theme.meter-mid 82%,
                    Theme.meter-high 100%);
                animate width { duration: 80ms; }
            }
            // LED ladder: thin separators in the well colour read as segments.
            for i in 32: Rectangle {
                x: parent.width * ((i + 1) / 33.0);
                width: 1px;
                height: 100%;
                background: Theme.surface-2.with-alpha(0.85);
            }
            // Peak hold.
            if root.available: Rectangle {
                width: 2px;
                x: (parent.width - self.width) * root.peak.clamp(0, 1);
                height: 100%;
                background: Theme.text;
                opacity: 0.85;
            }
        }
        Text {
            text: root.available ? "有信号" : "—";
            color: root.available ? Theme.text-muted : Theme.text-faint;
            font-family: Theme.font-mono;
            font-size: Theme.text-xs;
            width: 30px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// Stereo meter block with dB scale. `available` is false until the engine
// publishes real block levels: the app must never invent a measurement, so the
// zero state is explicit rather than animated.
export component LevelMeter inherits Rectangle {
    in property <float> left: 0;
    in property <float> right: 0;
    in property <float> peak-left: 0;
    in property <float> peak-right: 0;
    in property <bool> available: false;
    in property <string> caption: "输出电平";

    vertical-stretch: 0;
    background: transparent;

    VerticalLayout {
        spacing: Theme.space-2;
        SectionLabel { text: root.caption; }
        MeterChannel {
            label: "L";
            level: root.left;
            peak: root.peak-left;
            available: root.available;
        }
        MeterChannel {
            label: "R";
            level: root.right;
            peak: root.peak-right;
            available: root.available;
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            Rectangle { width: 10px; horizontal-stretch: 0; }
            // dBFS ruler printed under the tracks.
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 0;
                for label[t] in ["0", "−12", "−24", "−36", "−48", "−60", "−∞"]: Text {
                    text: label;
                    color: Theme.text-faint;
                    font-family: Theme.font-mono;
                    font-size: 9px;
                    horizontal-stretch: 1;
                    horizontal-alignment: t == 0 ? TextHorizontalAlignment.left
                        : (t == 6 ? TextHorizontalAlignment.right : TextHorizontalAlignment.center);
                }
            }
            Rectangle { width: 30px; horizontal-stretch: 0; }
        }
        if !root.available: Text {
            text: "无实时数据 · 会话运行后显示";
            color: Theme.text-faint;
            font-family: Theme.font-ui;
            font-size: Theme.text-xs;
        }
    }
}

// ---------------------------------------------------------------------------
// Small value tiles
// ---------------------------------------------------------------------------

export component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <color> accent: Theme.text;

    background: Theme.surface-3;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.hairline;
    vertical-stretch: 0;

    VerticalLayout {
        padding: Theme.space-3;
        spacing: 3px;
        Text {
            text: root.label;
            color: Theme.text-faint;
            font-size: Theme.text-xs;
            letter-spacing: Theme.tracking-label;
        }
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: root.value;
                color: root.accent;
                font-family: Theme.font-mono;
                font-size: Theme.text-xl;
                font-weight: Theme.weight-bold;
                vertical-alignment: bottom;
            }
            if root.unit != "": Text {
                text: root.unit;
                color: Theme.text-faint;
                font-family: Theme.font-mono;
                font-size: Theme.text-xs;
                vertical-alignment: bottom;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

// Label left / monospaced value right — the inspector row of the design.
export component KeyValue inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.text;
    spacing: Theme.space-3;
    Text {
        text: root.label;
        color: Theme.text-faint;
        font-family: Theme.font-ui;
        font-size: Theme.text-sm;
        vertical-alignment: center;
    }
    Rectangle { horizontal-stretch: 1; }
    Text {
        text: root.value;
        color: root.value-color;
        font-family: Theme.font-mono;
        font-size: Theme.text-sm;
        font-weight: Theme.weight-semibold;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Page title block; trailing controls can be injected as children.
export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    vertical-stretch: 0;
    // A nested layout inherits the available height unless it is constrained.
    // This keeps the header hugging its two text lines inside page layouts.
    height: title-text.preferred-height
        + (subtitle != "" ? Theme.text-md + 3px : 0px);
    spacing: Theme.space-4;
    VerticalLayout {
        vertical-stretch: 0;
        spacing: 3px;
        title-text := Text {
            text: root.title;
            color: Theme.text;
            font-family: Theme.font-ui;
            font-size: Theme.text-3xl;
            font-weight: Theme.weight-bold;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.text-muted;
            font-family: Theme.font-ui;
            font-size: Theme.text-md;
        }
    }
    Rectangle { horizontal-stretch: 1; }
    @children
}

// ---------------------------------------------------------------------------
// Navigation rail item
// ---------------------------------------------------------------------------

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    callback clicked();

    height: Theme.compact ? 40px : 44px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-md;
    background: active ? Theme.primary-soft : (ta.has-hover ? Theme.surface-3 : transparent);
    animate background { duration: Theme.fast; }

    // Active accent bar on the rail edge.
    Rectangle {
        x: 0;
        width: 2px;
        height: root.active ? 18px : 0px;
        y: (parent.height - self.height) / 2;
        border-radius: 1px;
        background: Theme.primary;
        animate height { duration: Theme.fast; easing: ease-out; }
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;
        Image {
            source: root.icon;
            colorize: root.active ? Theme.primary : Theme.text-faint;
            width: 17px;
            height: 17px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.text-muted;
            font-family: Theme.font-ui;
            font-size: Theme.text-md;
            font-weight: root.active ? Theme.weight-semibold : Theme.weight-regular;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---------------------------------------------------------------------------
// Signal graph pieces (routing canvas)
// ---------------------------------------------------------------------------

// Which side of the chain a node sits on; drives its accent hue.
//   source      -> device blue   (capture)
//   processor   -> violet        (gain / pan / effect)
//   destination -> recorder gold (render)
export enum NodeKind { source, processor, destination }

export component SignalNode inherits Rectangle {
    in property <NodeKind> kind: NodeKind.source;
    in property <string> type-label;
    in property <string> title;
    in property <string> meta;
    in property <bool> selected: false;
    in property <bool> live: false;

    width: Theme.compact ? 152px : 176px;
    height: Theme.compact ? 96px : 104px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-md;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: selected ? self.tint : Theme.border;
    drop-shadow-color: selected ? self.tint.with-alpha(0.25) : transparent;
    drop-shadow-blur: Theme.shadow-blur-sm;
    animate border-color { duration: Theme.fast; }

    property <color> tint:
        kind == NodeKind.source ? Theme.signal-device
        : kind == NodeKind.processor ? Theme.primary
        : Theme.signal-recorder;

    // Top accent hairline keeps the node class readable at a glance.
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 2px;
        background: root.tint.with-alpha(root.live ? 1.0 : 0.4);
    }

    VerticalLayout {
        padding: Theme.space-3;
        spacing: 5px;

        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-sm;
                background: root.tint.with-alpha(0.16);
                Image {
                    source: root.kind == NodeKind.source ? @image-url("icons/mic.svg")
                        : root.kind == NodeKind.processor ? @image-url("icons/sliders.svg")
                        : @image-url("icons/speaker.svg");
                    colorize: root.tint;
                    width: 13px;
                    height: 13px;
                }
            }
            Text {
                text: root.type-label;
                color: root.tint;
                font-family: Theme.font-ui;
                font-size: 9px;
                font-weight: Theme.weight-semibold;
                letter-spacing: Theme.tracking-label;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
        }

        Text {
            text: root.title;
            color: Theme.text;
            font-family: Theme.font-ui;
            font-size: Theme.text-md;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.meta;
            color: Theme.text-faint;
            font-family: Theme.font-mono;
            font-size: Theme.text-xs;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Horizontal connector between two nodes. The chevrons give the chain a
// direction without needing a genuine animated flow.
export component FlowLink inherits Rectangle {
    in property <color> tint: Theme.signal-device;
    in property <bool> live: false;

    horizontal-stretch: 1;
    min-width: 40px;
    background: transparent;

    Rectangle {
        x: 0;
        y: (parent.height - 1px) / 2;
        width: 100%;
        height: 1px;
        background: root.tint.with-alpha(root.live ? 0.55 : 0.3);
    }
    for i in 3: Image {
        source: @image-url("icons/chevron.svg");
        colorize: root.tint;
        width: 13px;
        height: 13px;
        x: parent.width * (0.26 + i * 0.24) - self.width / 2;
        y: (parent.height - self.height) / 2;
        transform-rotation: -90deg;
        opacity: 0.35 + (2 - abs(i - 1)) * 0.2;
    }
}
