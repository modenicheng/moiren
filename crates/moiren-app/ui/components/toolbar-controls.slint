import { Theme } from "../theme.slint";

// The full toolbar height is the hit target; the 30px visual control stays
// centered inside it. Content layout determines width independently of height.
export component ActionButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> text;
    in property <image> icon;
    in property <length> icon-size: 18px;
    in property <length> minimum-content-width: 0px;
    callback clicked();

    height: Theme.toolbar-height;
    width: max(root.minimum-content-width, content.preferred-width);
    horizontal-stretch: 0;
    opacity: root.enabled ? 1 : 0.45;

    Rectangle {
        width: root.width;
        height: Theme.toolbar-control-height;
        y: (root.height - self.height) / 2;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border-strong;
        background: touch.pressed || touch.has-hover ? Theme.surface-4 : Theme.surface-3;
        animate background { duration: Theme.fast; }

        content := HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: Theme.toolbar-content-spacing;
            alignment: center;

            Image {
                source: root.icon;
                colorize: Theme.text-muted;
                width: root.icon-size;
                height: root.icon-size;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: root.text;
                color: Theme.text-muted;
                font-family: Theme.font-ui;
                font-size: 12px;
                font-weight: Theme.weight-medium;
                horizontal-stretch: 0;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SwitchSegment inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    width: root.text == "Matrix" ? 72px : 76px;
    height: Theme.toolbar-height;
    horizontal-stretch: 0;
    opacity: root.enabled ? 1 : 0.4;

    Rectangle {
        y: (root.height - self.height) / 2;
        width: root.width;
        height: Theme.toolbar-control-height;

        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            height: 2px;
            visible: root.active;
            background: Theme.primary;
        }

        Text {
            text: root.text;
            color: root.active ? Theme.primary : Theme.text-muted;
            font-family: Theme.font-ui;
            font-size: 12px;
            font-weight: Theme.weight-medium;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component WindowButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 16px;
    in property <bool> danger-hover: false;
    callback clicked();

    width: Theme.toolbar-icon-button-width;
    height: Theme.toolbar-height;
    horizontal-stretch: 0;
    background: touch.has-hover
        ? (root.danger-hover ? Theme.danger : Theme.surface-4)
        : transparent;
    animate background { duration: Theme.fast; }

    Image {
        source: root.icon;
        colorize: touch.has-hover && root.danger-hover ? #ffffff : Theme.text-muted;
        width: root.icon-size;
        height: root.icon-size;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
