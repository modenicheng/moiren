// Studio controls — the 30px instrument controls of the Figma design:
// field buttons (icon + label), view-switcher segments, section headings,
// parameter rows, faders and channel meters.

import { Theme } from "../theme.slint";
import { TablerIcon } from "tabler-icon.slint";

// 30px control: #21282d fill, #30393f border, r4, icon + label.
// Used for the scene selector, engine stop, locate-connection, etc.
export component StudioButton inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";      // tabler name, "" = no icon
    in property <length> icon-size: 16px;
    in property <bool> enabled: true;
    in property <bool> active: false;
    callback clicked();

    height: 30px;
    horizontal-stretch: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.active ? Theme.primary : Theme.border;
    background: ta.pressed ? Theme.surface-4 : root.active ? #2b1f4a : ta.has-hover ? Theme.surface-4 : Theme.surface-3;
    animate background { duration: Theme.fast; }
    opacity: enabled ? 1.0 : 0.45;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": TablerIcon {
            name: root.icon;
            tint: root.active ? Theme.text : Theme.text-muted;
            width: root.icon-size;
            height: root.icon-size;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.active ? Theme.text : Theme.text-muted;
            font-family: Theme.font-ui;
            font-size: 12px;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Transparent until active; active = violet border + violet ink (no fill).
export component SwitchSegment inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();
    width: root.text == "Matrix" ? 72px : 76px;
    height: 30px;
    border-radius: 4px;
    border-width: 1px;
    border-color: active ? Theme.primary : transparent;
    Text {
        text: root.text;
        color: root.active ? Theme.primary : Theme.text-muted;
        font-family: Theme.font-ui;
        font-size: 12px;
        font-weight: Theme.weight-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Uppercase section heading with collapse chevron (library categories,
// inspector sections). 29px tall, 11px semibold.
export component SectionHeading inherits HorizontalLayout {
    in property <string> title;
    in property <bool> open: true;
    callback toggle();
    height: 29px;
    spacing: Theme.space-2;
    padding-top: Theme.space-3;
    padding-bottom: Theme.space-2;
    Text {
        text: root.title;
        color: Theme.text-muted;
        font-family: Theme.font-ui;
        font-size: 11px;
        font-weight: Theme.weight-semibold;
        vertical-alignment: center;
    }
    Rectangle { horizontal-stretch: 1; }
    Image {
        source: @image-url("../icons/chevron.svg");
        colorize: Theme.text-faint;
        width: 12px;
        height: 12px;
        y: (parent.height - self.height) / 2;
        transform-rotation: root.open ? 0deg : -90deg;
        animate transform-rotation { duration: Theme.fast; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
}

// Key left / mono value right — the inspector's read-only row (17px).
export component ParamRow inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    height: 17px;
    spacing: Theme.space-2;
    Text {
        text: root.key;
        color: Theme.text-muted;
        font-family: Theme.font-ui;
        font-size: 12px;
        vertical-alignment: center;
    }
    Rectangle { horizontal-stretch: 1; }
    Text {
        text: root.value;
        color: Theme.text;
        font-family: Theme.font-mono;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Vertical channel meter: 7px track, violet fill from the bottom, 2px
// peak head in danger red.
export component ChannelMeter inherits Rectangle {
    in property <float> level;   // 0..1
    in property <float> peak;    // 0..1
    width: 7px;
    height: 100%;
    border-radius: 2px;
    background: Theme.border;
    clip: true;
    Rectangle {
        x: 0;
        y: parent.height * (1.0 - root.level.clamp(0, 1));
        width: 100%;
        height: parent.height * root.level.clamp(0, 1);
        background: Theme.primary;
    }
    if root.peak > 0: Rectangle {
        x: 0;
        y: parent.height * (1.0 - root.peak.clamp(0, 1));
        width: 100%;
        height: 2px;
        background: Theme.danger;
    }
}

// Vertical fader: 7px rail + 20x36 white thumb; value 0..1 (top = max).
export component FaderRail inherits Rectangle {
    in property <bool> enabled: true;
    in-out property <float> value: 0.78;
    callback changed(float);

    width: 41px;
    height: 100%;
    background: transparent;

    Rectangle {
        x: (root.width - 7px) / 2;
        y: 2px;
        width: 7px;
        height: parent.height - 4px;
        border-radius: 2px;
        background: Theme.border;
    }
    Rectangle {
        width: 20px;
        height: 36px;
        x: (root.width - self.width) / 2;
        y: (parent.height - 40px) * (1.0 - root.value.clamp(0, 1)) + 2px;
        border-radius: 4px;
        background: #e9eef1;
        drop-shadow-color: #00000088;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 2px;
    }
    ta := TouchArea {
        enabled: root.enabled;
        property <length> grab-y;
        property <float> grab-v;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.grab-y = self.mouse-y;
                self.grab-v = root.value;
            }
        }
        moved => {
            if (self.pressed) {
                root.value = (self.grab-v + (self.grab-y - self.mouse-y) / max(1px, parent.height - 40px)).clamp(0, 1);
                root.changed(root.value);
            }
        }
    }
}
